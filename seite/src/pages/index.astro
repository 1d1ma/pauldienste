---
/**
 * Startseite nach der Stilrichtung "Dunkel" (stilvarianten.html): Hero mit drei
 * Bereichsflaechen in Farbe, drei Bereiche als ruhige Liste, Bodenbelaege,
 * Wandfarben, Ablauf, FAQ, Abschluss. Bewertungen fehlen bis echte vorliegen.
 * Die Farbflaechen im Hero sind Platzhalter fuer Fotos (siehe --foto).
 */
import Base from '../layouts/Base.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Section from '../components/Section.astro';
import Faq from '../components/Faq.astro';
import Icon from '../components/Icon.astro';
import FloorPlanks from '../components/FloorPlanks.astro';
import { bereiche } from '../data/leistungen';
import { internalLink, registry } from '../data/pages';
import { site } from '../data/site';

const href = (slug: string) => internalLink(slug).href;

const kacheln = [
  { bereich: 'reinigung', titel: 'Gebäudereinigung', text: 'Fenster, Büro, Fassade', icon: 'sparkle', klasse: 'gross' },
  { bereich: 'handwerk', titel: 'Handwerk', text: 'Boden, Wand, Montage', icon: 'paint-roller', klasse: '' },
  { bereich: 'hausmeister', titel: 'Hausmeisterservice', text: 'Winterdienst, Garten', icon: 'key', klasse: '' },
] as const;

const liste: Record<string, Array<[string, string]>> = {
  reinigung: [
    ['/fensterreinigung-kassel/', 'innen und außen'],
    ['/bueroreinigung-kassel/', 'Büros, Praxen, Läden'],
    ['/grundreinigung-kassel/', 'Einzug und Auszug'],
    ['/bauendreinigung-kassel/', 'nach Umbau'],
    ['/fassadenreinigung-kassel/', 'Putz und Klinker'],
  ],
  handwerk: [
    ['/boden-verlegen-kassel/', 'Vinyl, Parkett, Laminat'],
    ['/streichen-tapezieren-kassel/', 'sauber abgeklebt'],
    ['/kuechenmontage-moebelmontage-kassel/', 'Aufbau'],
    ['/fliegengitter-kassel/', 'nach Maß'],
    ['/plissees-kassel/', 'nach Maß'],
  ],
  hausmeister: [
    ['/winterdienst-kassel/', 'Räumen und Streuen'],
    ['/gartenpflege-kassel/', 'einmalig oder regelmäßig'],
    ['/entruempelung-kassel/', 'Wohnung, Keller, Garage'],
  ],
};
const notiz: Record<string, string> = {
  reinigung: 'für Haushalte, Verwaltungen und Gewerbe',
  handwerk: 'Renovierung und Innenausbau',
  hausmeister: 'für Privat und Vermieter',
};

const farben = [
  ['Kalkweiß', '#ECEAE5', '#1C1E21'],
  ['Greige', '#CFC7BA', '#1C1E21'],
  ['Salbei', '#9DA894', '#1C1E21'],
  ['Taupe', '#8C8076', '#fff'],
  ['Taubenblau', '#6D7D8A', '#fff'],
  ['Anthrazit', '#3A3D41', '#fff'],
] as const;

const ablauf = [
  ['Anfrage', 'Sie rufen an oder schreiben uns, worum es geht.'],
  ['Besichtigung', 'Wir sehen uns vor Ort an, was zu tun ist. Das kostet nichts.'],
  ['Festpreis', 'Sie erhalten ein schriftliches Angebot mit festem Preis.'],
  ['Ausführung', 'Wir arbeiten zum vereinbarten Termin und übergeben sauber.'],
] as const;

const faq = [
  {
    q: 'Was kostet die Besichtigung?',
    a: 'Nichts. Wir sehen uns Fläche und Zustand vor Ort an und nennen Ihnen danach einen Festpreis. Sie gehen damit keine Verpflichtung ein und entscheiden in Ruhe.',
  },
  {
    q: 'Wie kommt der Preis zustande?',
    a: 'Der Festpreis richtet sich nach Fläche, Zustand, Material, Zugang und Höhe. Weil wir vorher vor Ort waren, steht er fest und ändert sich nicht während der Arbeit.',
  },
  {
    q: 'Arbeiten Sie für Privatkunden und für Gewerbe?',
    a: 'Für beide. Jede Leistung gibt es für Haushalte, Büros, Praxen, Hausverwaltungen und Handel. Für Gewerbe planen wir Termine früh, abends oder am Wochenende, damit Ihr Betrieb nicht unterbrochen wird.',
  },
  {
    q: 'Kann ich Reinigung und Handwerk zusammen beauftragen?',
    a: 'Ja, und das ist oft sinnvoll. Bei einem Auszug entrümpeln, streichen, den Boden erneuern und reinigen wir in einem Auftrag. Sie haben einen Ansprechpartner und einen Festpreis statt mehrerer Angebote.',
  },
  {
    q: 'Wie erreiche ich Sie?',
    a: `Telefonisch unter ${site.kontakt.telefonAnzeige} von Montag bis Freitag zwischen 8 und 17 Uhr, per E-Mail an ${site.kontakt.email} oder über das Anfrageformular.`,
  },
];
---

<Base slug="/">
  <Header slot="header" />

  <!-- Hero -->
  <section class="hero" data-anim="hero">
    <div class="container hero__inner">
      <div class="hero__text">
        <h1 data-anim="hero-title">Reinigung und Handwerk aus einer Hand in Kassel</h1>
        <p class="hero__intro">
          Gebäudereinigung, Renovierung und Hausmeisterservice für Privat und Gewerbe. Ein Ansprechpartner, ein Festpreis.
        </p>
        <div class="hero__actions">
          <a class="btn btn--gold lift" href={site.angebotUrl}>Besichtigung anfragen</a>
          <a class="btn btn--ghost lift" href="#bereiche">Leistungen ansehen</a>
        </div>
      </div>

      <ul class="mosaik" data-anim="mosaik">
        {
          kacheln.map((k) => (
            <li class={`mosaik__item ${k.klasse}`}>
              <a href={href(bereiche.find((b) => b.id === k.bereich)!.start)} class={`kachel kachel--${k.bereich} lift`} data-anim="kachel">
                <span class="kachel__icon"><Icon name={k.icon} size={64} /></span>
                <span class="kachel__text">
                  <strong>{k.titel}</strong>
                  <span>{k.text}</span>
                </span>
              </a>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <!-- Drei Bereiche -->
  <Section id="bereiche" variant="alt" title="Drei Bereiche, ein Ansprechpartner">
    <div class="bereiche reveal" data-anim="bereiche">
      {
        bereiche.map((b) => (
          <section class="bereich" aria-labelledby={`b-${b.id}`}>
            <header>
              <h3 id={`b-${b.id}`}>{b.label}</h3>
              <p>{notiz[b.id]}</p>
            </header>
            <ul>
              {liste[b.id].map(([slug, text]) => (
                <li>
                  <a href={href(slug)}>
                    <span>{registry[slug].label}</span>
                    <small>{text}</small>
                  </a>
                </li>
              ))}
            </ul>
            <a class="bereich__alle" href={href(b.start)}>
              Alle Leistungen <Icon name="arrow-right" size={16} />
            </a>
          </section>
        ))
      }
    </div>
  </Section>

  <!-- Bodenbelaege -->
  <section class="split split--boden" data-anim="boden">
    <div class="split__bild"><FloorPlanks /></div>
    <div class="split__text">
      <h2>Premium-Bodenbeläge</h2>
      <p>Vinyl, Parkett und Designböden zum Anfassen. Wir beraten Sie in unserer Ausstellung in Kassel nach Terminvereinbarung und verlegen den Boden.</p>
      <a class="btn btn--ghost lift" href={href('/bodenbelaege-farben-kassel/')}>Bodenbeläge ansehen</a>
    </div>
  </section>

  <!-- Wandfarben -->
  <section class="split split--farben" data-anim="farben">
    <div class="split__text">
      <h2>Wandfarben in Profiqualität</h2>
      <p>Farbton aussuchen, Muster an der Wand prüfen, streichen lassen. Alles aus einer Hand.</p>
      <a class="btn btn--ghost lift" href={href('/bodenbelaege-farben-kassel/')}>Farben ansehen</a>
    </div>
    <ul class="farben" aria-label="Beispiel-Farbtöne">
      {
        farben.map(([name, hex, ink]) => (
          <li style={`--c:${hex}; --ink:${ink}`}><span>{name}</span></li>
        ))
      }
    </ul>
  </section>

  <!-- Ablauf -->
  <Section id="ablauf" variant="default" title="So läuft es ab">
    <ol class="ablauf stagger" data-anim="ablauf">
      {
        ablauf.map(([titel, text], i) => (
          <li class="ablauf__schritt reveal" data-anim="ablauf-schritt">
            <span class="ablauf__nr" aria-hidden="true">{i + 1}</span>
            <h3>{titel}</h3>
            <p>{text}</p>
          </li>
        ))
      }
    </ol>
  </Section>

  <!-- FAQ -->
  <Section id="faq" variant="alt">
    <div class="faq-grid">
      <h2 class="reveal">Häufige Fragen</h2>
      <div class="faq-wrap reveal"><Faq items={faq} /></div>
    </div>
  </Section>

  <!-- Abschluss -->
  <section class="abschluss">
    <div class="container abschluss__inner">
      <h2>Reinigung oder Reparatur? Wir kümmern uns.</h2>
      <a class="btn btn--gold lift" href={site.angebotUrl}>Besichtigung anfragen</a>
    </div>
  </section>

  <Footer slot="footer" />
</Base>

<style>
  /* --- Buttons (ein Stil: Gold, daneben Kontur) --- */
  .btn {
    display: inline-flex; align-items: center; justify-content: center;
    min-height: 3rem; padding: 0 1.5rem; border-radius: var(--radius);
    font-weight: var(--weight-bold); font-size: 0.95rem; text-decoration: none; white-space: nowrap;
  }
  .btn--gold { background: var(--color-primary); color: var(--color-primary-contrast); }
  .btn--gold:hover { background: var(--color-primary-hover); color: var(--color-primary-contrast); }
  .btn--ghost { border: 1px solid var(--color-primary); color: var(--color-primary-on-dark); }
  .btn--ghost:hover { background: rgb(185 155 99 / 0.12); color: #fff; }

  /* --- Hero --- */
  .hero { background: var(--color-petrol); padding-block: clamp(2.5rem, 6vw, 5rem); }
  .hero__inner { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(2rem, 6vw, 5rem); align-items: center; }
  @media (max-width: 900px) { .hero__inner { grid-template-columns: 1fr; } }
  .hero h1 { color: #fff; font-size: clamp(2rem, 1.2rem + 2.4vw, 2.9rem); letter-spacing: -0.02em; max-width: 19ch; }
  .hero__intro { margin-top: var(--space-4); color: var(--color-on-dark-soft); font-size: 1.05rem; max-width: 40ch; }
  .hero__actions { margin-top: var(--space-8); display: flex; flex-wrap: wrap; gap: var(--space-3); }

  .mosaik {
    list-style: none; padding: 0; margin: 0; position: relative;
    display: grid; grid-template-columns: 1.1fr 1fr; grid-template-rows: 1fr 1fr; gap: 10px;
    aspect-ratio: 1 / 0.92;
  }
  /* goldener Rahmen versetzt dahinter */
  .mosaik::before {
    content: ''; position: absolute; inset: 0; transform: translate3d(14px, -14px, 0);
    border: 1px solid var(--color-primary); opacity: 0.55; pointer-events: none;
  }
  .mosaik__item { margin: 0; position: relative; }
  .mosaik__item.gross { grid-row: span 2; }
  .kachel {
    position: relative; display: flex; flex-direction: column; justify-content: flex-end;
    height: 100%; min-height: 9rem; padding: var(--space-4);
    background: var(--kachel); color: var(--kachel-ink);
    background-image: var(--foto, none); background-size: cover; background-position: center;
    text-decoration: none; overflow: clip;
  }
  .kachel--reinigung { --kachel: #4E5A63; --kachel-ink: #F2F3F2; }
  .kachel--handwerk { --kachel: #6F5A45; --kachel-ink: #F5EFE6; }
  .kachel--hausmeister { --kachel: #56604F; --kachel-ink: #F1F3EE; }
  .kachel__icon { position: absolute; top: var(--space-4); right: var(--space-4); opacity: 0.22; }
  .kachel__text { position: relative; display: grid; gap: 2px; }
  .kachel__text strong { font-family: var(--font-heading); font-size: 1.05rem; line-height: 1.2; }
  .kachel__text span { font-size: 0.85rem; opacity: 0.8; }
  .kachel:hover { filter: brightness(1.08); }

  /* --- Drei Bereiche --- */
  .bereiche { display: grid; grid-template-columns: repeat(3, 1fr); background: #fff; border: 1px solid var(--color-border); border-radius: var(--radius-lg); }
  @media (max-width: 900px) { .bereiche { grid-template-columns: 1fr; } }
  .bereich { padding: var(--space-6); display: flex; flex-direction: column; }
  .bereich + .bereich { border-left: 1px solid var(--color-border); }
  @media (max-width: 900px) { .bereich + .bereich { border-left: 0; border-top: 1px solid var(--color-border); } }
  .bereich header h3 { font-size: 1.15rem; color: var(--color-heading); }
  .bereich header p { font-size: 0.85rem; color: var(--color-accent-text); margin-top: 2px; }
  .bereich ul { list-style: none; padding: 0; margin: var(--space-4) 0; flex: 1; }
  .bereich li { margin: 0; }
  .bereich li a {
    display: flex; justify-content: space-between; align-items: baseline; gap: var(--space-4);
    padding: 0.7rem 0; border-top: 1px solid var(--color-border);
    text-decoration: none; color: var(--color-heading); font-weight: var(--weight-medium); font-size: 0.95rem;
  }
  .bereich li a small { color: var(--color-text-muted); font-size: 0.8rem; font-weight: var(--weight-normal); text-align: right; }
  .bereich li a:hover span { color: var(--color-accent-text); }
  .bereich__alle { display: inline-flex; align-items: center; gap: var(--space-2); font-weight: var(--weight-bold); font-size: 0.9rem; color: var(--color-accent-text); text-decoration: none; }
  .bereich__alle:hover { color: var(--color-heading); }

  /* --- Split: Boden und Farben --- */
  .split { display: grid; grid-template-columns: 1fr 1fr; min-height: 26rem; }
  @media (max-width: 800px) { .split { grid-template-columns: 1fr; } }
  .split__bild { position: relative; min-height: 16rem; overflow: clip; }
  .split__text { display: flex; flex-direction: column; align-items: flex-start; justify-content: center; gap: var(--space-4); padding: clamp(2rem, 6vw, 5rem); }
  .split__text h2 { color: #fff; font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.2rem); }
  .split__text p { color: var(--color-on-dark-soft); max-width: 42ch; }
  .split--boden { background: var(--color-petrol); }
  .split--farben { background: var(--color-graphit-soft); }
  @media (max-width: 800px) { .split--farben .split__text { order: 1; } }

  .farben { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(6, 1fr); min-height: 22rem; }
  .farben li { margin: 0; background: var(--c); color: var(--ink); padding: var(--space-4) 0; display: flex; justify-content: center; }
  .farben span { writing-mode: vertical-rl; transform: rotate(180deg); font-size: 0.8rem; font-weight: var(--weight-medium); letter-spacing: 0.04em; }
  @media (max-width: 800px) { .farben { min-height: 14rem; } }

  /* --- Ablauf --- */
  .ablauf { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--space-8) var(--space-6); }
  @media (max-width: 900px) { .ablauf { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .ablauf { grid-template-columns: 1fr; } }
  .ablauf__schritt { margin: 0; padding-top: var(--space-4); border-top: 1px solid var(--color-primary); }
  .ablauf__nr { font-family: var(--font-heading); font-weight: var(--weight-bold); font-size: 1.8rem; line-height: 1; color: var(--color-accent-text); display: block; margin-bottom: var(--space-3); }
  .ablauf__schritt h3 { font-size: 1.1rem; }
  .ablauf__schritt p { margin-top: var(--space-2); font-size: 0.92rem; line-height: 1.55; color: var(--color-text-muted); }

  /* --- FAQ --- */
  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.7fr) minmax(0, 1.3fr); gap: clamp(2rem, 6vw, 5rem); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; gap: var(--space-4); } }

  /* --- Abschluss --- */
  .abschluss { background: var(--color-petrol-dark); padding-block: clamp(2.5rem, 5vw, 3.5rem); }
  .abschluss__inner { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: var(--space-6); }
  .abschluss h2 { color: #fff; font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem); max-width: 28ch; }
</style>
