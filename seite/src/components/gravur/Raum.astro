---
/**
 * Vignette Innenausbau: Raum in Zentralperspektive. Dielen laufen auf den
 * Fluchtpunkt zu, die Rueckwand ist zur Haelfte frisch gestrichen, die Rolle
 * steht an der Kante. Rechts ein Fenster mit Plissee.
 */
import { n, schraffur, zufall } from '../../lib/gravur';

interface Props { id?: string; }
const { id = 'gv-raum' } = Astro.props;
const r = zufall(57);
const W = 400, H = 250;
const VP = { x: 214, y: 112 };
const wand = { l: 118, r: 300, o: 34, u: 168 };
const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
// Punkt auf dem Strahl vom Fluchtpunkt durch (x, H), auf Hoehe y
const strahl = (xf: number, y: number) => VP.x + (xf - VP.x) * ((y - VP.y) / (H - VP.y));

// Dielen
const dielen: string[] = [];
const stoesse: string[] = [];
const breite = 34;
for (let xf = VP.x - breite * 14 + 7; xf < W + breite * 14; xf += breite) {
  const xb = strahl(xf, wand.u);
  dielen.push(`M${n(xb)} ${wand.u}L${n(xf)} ${H}`);
  // Stoesse: Tiefe in Perspektive, je Diele versetzt
  let t = 0.08 + r() * 0.3;
  while (t < 1) {
    const y = lerp(wand.u, H, t);
    const xa = strahl(xf, y), xc = strahl(xf + breite, y);
    stoesse.push(`M${n(xa)} ${n(y)}L${n(xc)} ${n(y)}`);
    t += 0.42 + t * 0.4;
  }
}
// Holzmaserung: feine Linien zwischen den Dielen
const maser: string[] = [];
for (let xf = VP.x - breite * 14 + 7; xf < W + breite * 14; xf += breite / 4) {
  if (r() < 0.45) continue;
  const t0 = r() * 0.6;
  const y0 = lerp(wand.u, H, t0), y1 = lerp(wand.u, H, Math.min(1, t0 + 0.2 + r() * 0.4));
  maser.push(`M${n(strahl(xf, y0))} ${n(y0)}L${n(strahl(xf, y1))} ${n(y1)}`);
}

const boden = `M${wand.l} ${wand.u}L${wand.r} ${wand.u}L${W + 1} ${H + 30}L-1 ${H + 30}Z`;
const links = `M-1 -1L${wand.l} ${wand.o}L${wand.l} ${wand.u}L-1 ${H + 30}Z`;
const rechts = `M${W + 1} -1L${wand.r} ${wand.o}L${wand.r} ${wand.u}L${W + 1} ${H + 30}Z`;
const decke = `M-1 -1L${W + 1} -1L${wand.r} ${wand.o}L${wand.l} ${wand.o}Z`;

// Rueckwand: links frisch gestrichen (Kreuzschraffur), rechts alt (hell)
const kante = 212;
const rollKante = (() => {
  const pts: string[] = [];
  for (let y = wand.o; y <= wand.u; y += 6) pts.push(`${n(kante + Math.sin(y * 0.35) * 2.2 + (r() - 0.5) * 1.6)} ${y}`);
  return pts;
})();
const neu = `M${wand.l} ${wand.o}L${rollKante.join('L')}L${wand.l} ${wand.u}Z`;

// Fenster mit Plissee in der rechten Wand
const fen = (t: number, y: number) => {
  // x auf der rechten Wand: t = 0 Rueckwand, 1 vorn
  const x = lerp(wand.r, W, t);
  const yo = lerp(wand.o, 0, t), yu = lerp(wand.u, H + 30, t);
  return [x, lerp(yo, yu, y)] as const;
};
const fp = [fen(0.25, 0.18), fen(0.62, 0.12), fen(0.62, 0.62), fen(0.25, 0.6)];
const fenster = `M${fp.map(([x, y]) => `${n(x)} ${n(y)}`).join('L')}Z`;
const falten: string[] = [];
for (let i = 1; i < 12; i++) {
  const t = i / 12;
  const a = fen(0.25, lerp(0.18, 0.6, t) - 0.006 * (i % 2));
  const b = fen(0.62, lerp(0.12, 0.62, t) - 0.006 * (i % 2));
  falten.push(`M${n(a[0])} ${n(a[1])}L${n(b[0])} ${n(b[1])}`);
}
---

<svg class="gravur" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" aria-hidden="true" focusable="false">
  <defs>
    <clipPath id={`${id}-boden`}><path d={boden} /></clipPath>
    <clipPath id={`${id}-links`}><path d={links} /></clipPath>
    <clipPath id={`${id}-rechts`}><path d={rechts} /></clipPath>
    <clipPath id={`${id}-decke`}><path d={decke} /></clipPath>
    <clipPath id={`${id}-neu`}><path d={neu} /></clipPath>
    <clipPath id={`${id}-alt`}><path d={`M${kante - 6} ${wand.o}H${wand.r}V${wand.u}H${kante - 6}Z`} /></clipPath>
  </defs>
  <g class="gravur__strich">
    <g clip-path={`url(#${id}-links)`}><path d={schraffur(0, 0, wand.l, H + 30, 3, 90, r, 0.5)} stroke-width="0.6" opacity="0.8" /></g>
    <g clip-path={`url(#${id}-rechts)`}><path d={schraffur(wand.r, 0, W - wand.r, H + 30, 6, 90, r, 0.5)} stroke-width="0.5" opacity="0.45" /></g>
    <g clip-path={`url(#${id}-decke)`}><path d={schraffur(0, 0, W, wand.o, 4, 0, r, 0.4)} stroke-width="0.5" opacity="0.5" /></g>

    <g clip-path={`url(#${id}-alt)`}><path d={schraffur(wand.l, wand.o, wand.r - wand.l, wand.u - wand.o, 7, 90, r, 1)} stroke-width="0.5" opacity="0.35" /></g>
    <g clip-path={`url(#${id}-neu)`}>
      <path d={schraffur(wand.l, wand.o, wand.r - wand.l, wand.u - wand.o, 2.6, 90, r, 0.4)} stroke-width="0.6" opacity="0.85" />
      <path d={schraffur(wand.l, wand.o, wand.r - wand.l, wand.u - wand.o, 4.2, 20, r, 0.6)} stroke-width="0.45" opacity="0.5" />
    </g>
    <path d={`M${rollKante.join('L')}`} stroke-width="0.8" />

    <g clip-path={`url(#${id}-boden)`}>
      <path d={dielen.join('')} stroke-width="0.9" />
      <path d={stoesse.join('')} stroke-width="0.8" />
      <path d={maser.join('')} stroke-width="0.45" opacity="0.6" />
    </g>

    <!-- Raumkanten und Fussleisten -->
    <path d={`M${wand.l} ${wand.o}H${wand.r}V${wand.u}H${wand.l}Z M-1 -1L${wand.l} ${wand.o}M${W + 1} -1L${wand.r} ${wand.o}M-1 ${H + 30}L${wand.l} ${wand.u}M${W + 1} ${H + 30}L${wand.r} ${wand.u}`} stroke-width="1.2" />
    <path d={`M${wand.l} ${wand.u - 5}H${wand.r}M${wand.l} ${wand.u - 5}L-1 ${n(H + 30 - 14)}M${wand.r} ${wand.u - 5}L${W + 1} ${n(H + 30 - 14)}`} stroke-width="0.7" />

    <!-- Fenster mit Plissee -->
    <path class="gravur__grund" d={fenster} />
    <path d={falten.join('')} stroke-width="0.6" />
    <path d={fenster} stroke-width="1.3" />

    <!-- Farbrolle an der Kante -->
    <g transform={`translate(${kante + 4} 70)`}>
      <path d="M8 6V40Q8 46 14 50L30 70L38 128" stroke-width="1.6" />
      <path class="gravur__grund" d="M33 100L42 99L46 150L36 151Z" />
      <path d="M33 100L42 99L46 150L36 151Z" stroke-width="1.1" />
      <path d="M36 108l7 -0.5M37 116l7 -0.5M37.5 124l7 -0.5M38 132l7 -0.5M38.5 140l7 -0.5" stroke-width="0.5" opacity="0.7" />
      <path class="gravur__grund" d="M0 -14h16v34h-16Z" />
      <path d="M0 -14h16v34h-16Z" stroke-width="1.2" />
      <path d="M3 -12v30M5.5 -12v30M8 -12v30M10.5 -12v30M13 -12v30" stroke-width="0.55" opacity="0.8" />
    </g>
  </g>
</svg>
