---
/** Waehlt die Grafik zum Bereich (Stil A, Gold-Silhouetten). */
import type { Bereich } from '../../data/leistungen';
import Buero from './Buero.astro';
import Wohnhaus from './Wohnhaus.astro';
import Wohnraum from './Wohnraum.astro';

interface Props { bereich: Bereich['id']; id?: string; }
const { bereich, id } = Astro.props;
---

{bereich === 'reinigung' && <Buero id={id} />}
{bereich === 'handwerk' && <Wohnraum id={id} />}
{bereich === 'hausmeister' && <Wohnhaus id={id} />}
