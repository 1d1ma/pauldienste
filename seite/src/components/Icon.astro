---
/**
 * Icon – kleines Linien-Icon-Set, bewusst zurückhaltend.
 *
 * Regeln: 1,5 px Strichstärke, `currentColor`, quadratisch, keine Füllflächen,
 * keine Icon-Kacheln mit Hintergrund. Ein Icon ist hier ein Lesezeichen für
 * das Auge, kein Dekor.
 *
 *   <Icon name="barrierefrei" />
 */
interface Props {
  name:
    | 'barrierefrei' | 'daemmung' | 'licht' | 'platz' | 'sicherheit'
    | 'fachbetrieb' | 'lieferung' | 'stern' | 'erfahrung' | 'preis'
    | 'pfeil';
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

// Alle Pfade auf 24×24 gezeichnet
const paths: Record<Props['name'], string> = {
  // Schwellenlos: Fläche mit flachem Übergang statt Stufe
  barrierefrei: '<path d="M3 17h18"/><path d="M3 17l4-3h10l4 3"/><path d="M9 14V6"/><path d="M15 14V6"/>',
  // Wärmedämmung: Thermometer
  daemmung: '<path d="M14 14.8V5a2 2 0 1 0-4 0v9.8a4 4 0 1 0 4 0Z"/><path d="M12 9v6"/>',
  // Licht: Sonne über Horizont
  licht: '<circle cx="12" cy="11" r="3.5"/><path d="M12 3v2M12 17v2M4.9 11H3M21 11h-1.9M6.5 5.5 5.1 4.1M18.9 4.1l-1.4 1.4"/><path d="M3 20h18"/>',
  // Platzsparend: Flügel gleitet zur Seite
  platz: '<rect x="3" y="4" width="18" height="16" rx="1"/><path d="M12 4v16"/><path d="M6.5 12h4"/><path d="M9 9.5 6.5 12 9 14.5"/>',
  // Sicherheit: Schild
  sicherheit: '<path d="M12 3 5 6v5.5c0 4.2 2.9 7.6 7 9.5 4.1-1.9 7-5.3 7-9.5V6l-7-3Z"/><path d="m9.5 12 1.8 1.8 3.4-3.6"/>',
  // Fachbetrieb: Zollstock/Winkel
  fachbetrieb: '<path d="M3 16.5 16.5 3l4.5 4.5L7.5 21 3 16.5Z"/><path d="m8 11.5 2 2M11 8.5l2 2M14 5.5l2 2"/>',
  lieferung: '<path d="M3 7h11v9H3z"/><path d="M14 10h4l3 3v3h-7z"/><circle cx="7" cy="18" r="1.8"/><circle cx="17" cy="18" r="1.8"/>',
  stern: '<path d="m12 3.5 2.6 5.4 5.9.8-4.3 4.1 1.1 5.9-5.3-2.9-5.3 2.9 1.1-5.9L3.5 9.7l5.9-.8L12 3.5Z"/>',
  erfahrung: '<circle cx="12" cy="12" r="9"/><path d="M12 7v5.2l3.2 2"/>',
  preis: '<path d="M20.5 12.5 12.5 20.5a2 2 0 0 1-2.8 0l-6.2-6.2a2 2 0 0 1-.6-1.4V5a2 2 0 0 1 2-2h7.9a2 2 0 0 1 1.4.6l6.3 6.3a2 2 0 0 1 0 2.6Z"/><circle cx="7.8" cy="7.8" r="1.3"/>',
  pfeil: '<path d="M5 12h14"/><path d="m13 6 6 6-6 6"/>',
};
---

<svg
  class={`icon ${className}`}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width="1.5"
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
  focusable="false"
  set:html={paths[name]}
/>

<style>
  .icon { flex: none; display: block; }
</style>
