---
import type { IconName } from '../lib/icons';

/**
 * Icon: Phosphor, Schnitt "light", lokal inline (kein Request, keine
 * Drittanbieter). Eine Familie, eine Strichstaerke. Farbe ueber currentColor.
 */
const files = import.meta.glob('/node_modules/@phosphor-icons/core/assets/light/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
}) as Record<string, string>;

interface Props {
  name: IconName;
  size?: number;
  class?: string;
}
const { name, size = 24, class: className = '' } = Astro.props;

const raw = files[`/node_modules/@phosphor-icons/core/assets/light/${name}-light.svg`];
if (!raw) throw new Error(`[Icon] Unbekanntes Icon "${name}"`);
const svg = raw.replace(
  '<svg ',
  `<svg class="icon ${className}" width="${size}" height="${size}" aria-hidden="true" focusable="false" `,
);
---

<Fragment set:html={svg} />

<style is:global>
  .icon { flex: none; display: block; }
</style>
