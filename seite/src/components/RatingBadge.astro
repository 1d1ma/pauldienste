---
/**
 * RatingBadge: kleines Google-Bewertungs-Badge fuer den Hero. Zahlen aus
 * site.ts (echte Google-Daten). Verweist auf die Bewertungsleiste.
 */
import { bewertungen } from '../data/site';
import GoogleG from './GoogleG.astro';

const note = bewertungen.schnitt.toLocaleString('de-DE', { minimumFractionDigits: 1 });
---

{
  bewertungen.echt && (
    <a class="badge" href="#bewertungen" aria-label={`${note} von 5 Sternen, ${bewertungen.anzahl} Google-Bewertungen`}>
      <GoogleG size={20} />
      <span class="badge__sterne" aria-hidden="true">
        {Array.from({ length: 5 }).map(() => (
          <svg viewBox="0 0 20 20" width="14" height="14"><path d="M10 1.6l2.5 5.2 5.7.7-4.2 3.9 1.1 5.6L10 14.2 4.9 17l1.1-5.6L1.8 7.5l5.7-.7z" fill="currentColor" /></svg>
        ))}
      </span>
      <span class="badge__text"><strong>{note}</strong> · {bewertungen.anzahl} Google-Bewertungen</span>
    </a>
  )
}

<style>
  .badge { display: inline-flex; align-items: center; gap: 0.6rem; text-decoration: none; color: var(--color-on-dark-soft); font-size: 0.85rem; }
  .badge:hover .badge__text { color: #fff; }
  .badge__sterne { display: inline-flex; gap: 1px; color: var(--color-primary); }
  .badge__sterne svg { display: block; }
  .badge__text strong { color: #fff; font-weight: var(--weight-bold); }
  .badge__text { transition: color var(--duration-fast) var(--ease-out-soft); }
</style>
