---
/**
 * Header: zwei Aufklapp-Gruppen (Reinigung hell, Handwerk dunkel), Menuepunkte
 * kommen aus pages.ts (Cluster reinigung und handwerk, auch geplante Seiten).
 * Gruppen-Labels haben keine eigene URL, die Bereichsseiten stehen als erster
 * Eintrag im Aufklappmenue.
 */
import { navByCluster } from '../data/pages';
import { site } from '../data/site';
import InternalLink from './InternalLink.astro';

const bereiche = [
  { label: 'Gebäudereinigung', start: '/gebaeudereinigung-kassel/', items: navByCluster('reinigung') },
  { label: 'Handwerk', start: '/handwerker-kassel/', items: navByCluster('handwerk') },
];
---

<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="logo" aria-label="Paul Gebäudedienste, zur Startseite">
      <img src="/logo/quer-hell.svg" alt="Paul Nagel Gebäudedienste" width="464" height="128" />
    </a>

    <input type="checkbox" id="nav-toggle" class="visually-hidden" aria-label="Menü" />
    <label for="nav-toggle" class="burger" aria-hidden="true">
      <span></span><span></span><span></span>
    </label>

    <nav class="site-nav" aria-label="Hauptnavigation">
      <ul class="site-nav__list">
        {
          bereiche.map((b) => (
            <li class="site-nav__group">
              <button type="button" class="site-nav__label transition-colors" aria-expanded="false">
                {b.label}
                <svg viewBox="0 0 20 20" width="13" height="13" aria-hidden="true">
                  <path d="M5 7.5 10 12.5 15 7.5" fill="none" stroke="currentColor"
                    stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
              </button>
              <ul class="site-nav__sub">
                {b.items.map((p) => (
                  <li class={p.slug === b.start ? 'is-start' : ''}>
                    <InternalLink to={p.slug}>{p.slug === b.start ? `Alle Leistungen: ${p.label}` : p.label}</InternalLink>
                  </li>
                ))}
              </ul>
            </li>
          ))
        }
        <li><InternalLink to="/ueber-uns/">Über uns</InternalLink></li>
        <li><InternalLink to="/kontakt/">Kontakt</InternalLink></li>
        <li class="site-nav__tel"><a href={`tel:${site.kontakt.telefon}`}>{site.kontakt.telefonAnzeige}</a></li>
        <li class="site-nav__cta">
          <a href={site.angebotUrl}>Besichtigung anfragen</a>
        </li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: var(--color-bg-alt);
    border-bottom: 1px solid var(--color-border);
    position: sticky;
    top: 0;
    z-index: 50;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-6);
    min-height: 4.25rem;
  }

  .logo { display: block; line-height: 0; flex: none; }
  .logo img { height: 3.1rem; width: auto; }
  @media (max-width: 560px) { .logo img { height: 2.6rem; } }

  .site-nav__list {
    display: flex;
    align-items: center;
    gap: clamp(var(--space-4), 1.6vw, var(--space-6));
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .site-nav__list li { margin: 0; }

  /* :global nötig, weil Links teils von der InternalLink-Komponente gerendert
     werden und damit NICHT im Scope dieser Datei liegen. Ohne :global bliebe
     dort die globale Unterstreichung stehen. */
  .site-nav :global(a),
  .site-nav__label {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: var(--weight-medium);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    white-space: nowrap;
  }
  .site-nav :global(a:hover),
  .site-nav__label:hover { color: var(--color-accent-text); }

  .site-nav__group { position: relative; }

  .site-nav__sub {
    position: absolute;
    top: calc(100% + 0.75rem);
    left: -0.75rem;
    min-width: 13.5rem;
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    box-shadow: 0 8px 24px rgb(28 30 33 / 0.14);
    padding: var(--space-2);
    list-style: none;
    margin: 0;

    opacity: 0;
    visibility: hidden;
    transform: translate3d(0, -4px, 0);
    transition:
      opacity var(--duration-fast) var(--ease-out-soft),
      transform var(--duration-fast) var(--ease-out-soft),
      visibility 0s linear var(--duration-fast);
  }
  .site-nav__group:hover .site-nav__sub,
  .site-nav__group:focus-within .site-nav__sub {
    opacity: 1;
    visibility: visible;
    transform: translate3d(0, 0, 0);
    transition-delay: 0s;
  }

  .site-nav__sub :global(a) {
    display: block;
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-sm);
    color: var(--color-text);
  }
  .site-nav__sub :global(a:hover) {
    background: var(--color-bg-alt);
    color: var(--color-petrol);
  }
  .is-start :global(a) { font-weight: var(--weight-bold); border-bottom: 1px solid var(--color-border); border-radius: 0; margin-bottom: var(--space-1); }
  .site-nav__tel :global(a) { font-weight: var(--weight-bold); white-space: nowrap; }

  /* Der einzige farbige Anker in der Leiste – dadurch bleibt er die Aktion */
  .site-nav__cta :global(a) {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
    padding: 0.55rem 1.1rem;
    border-radius: var(--radius);
    font-weight: var(--weight-bold);
    font-size: 0.9rem;
  }
  .site-nav__cta :global(a:hover) {
    background: var(--color-primary-hover);
    color: var(--color-primary-contrast);
  }

  /* --- Mobil --- */
  .burger { display: none; }

  @media (max-width: 980px) {
    .burger {
      display: flex;
      flex-direction: column;
      gap: 4px;
      cursor: pointer;
      padding: var(--space-2);
    }
    .burger span {
      display: block;
      width: 22px;
      height: 2px;
      background: var(--color-petrol);
      border-radius: 2px;
    }

    .site-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      background: var(--color-bg-alt);
      border-bottom: 1px solid var(--color-border);
      display: none;
      max-height: calc(100vh - 4.25rem);
      overflow-y: auto;
      padding: var(--space-4) var(--container-padding) var(--space-6);
    }
    /* Die Checkbox ist unsichtbar, traegt aber den Tastaturfokus: Der Ring
       muss deshalb am sichtbaren Burger erscheinen. */
    #nav-toggle:focus-visible + .burger {
      outline: 2px solid var(--color-primary);
      outline-offset: 4px;
      border-radius: var(--radius-sm);
    }
    #nav-toggle:checked ~ .site-nav { display: block; }

    .site-nav__list { flex-direction: column; align-items: flex-start; gap: var(--space-4); }
    .site-nav__sub {
      position: static;
      opacity: 1;
      visibility: visible;
      transform: none;
      border: 0;
      box-shadow: none;
      padding: var(--space-2) 0 0 var(--space-4);
    }
  }
</style>
