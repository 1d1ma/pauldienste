---
/**
 * FloorPlanks: Dielenboden als Vektor (Platzhalter fuer ein echtes Foto der
 * Ausstellung). Verbandsmuster mit festen Zufallswerten, damit der Build
 * reproduzierbar bleibt.
 */
const W = 600, H = 560, PH = 26;
const tones = ['#8a6a46', '#7a5c3b', '#946f49', '#6f5336', '#85653f', '#9a7650'];
let seed = 7;
const rnd = () => ((seed = (seed * 9301 + 49297) % 233280) / 233280);
const planks: Array<{ x: number; y: number; w: number; c: string }> = [];
for (let row = 0; row * PH < H; row++) {
  let x = -Math.floor(rnd() * 300);
  while (x < W) {
    const w = 230 + Math.floor(rnd() * 220);
    planks.push({ x, y: row * PH, w, c: tones[Math.floor(rnd() * tones.length)] });
    x += w;
  }
}
---

<svg viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMidYMid slice" role="img" aria-label="Dielenboden in warmen Holztönen" class="planks">
  {planks.map((p) => <rect x={p.x + 1} y={p.y + 1} width={p.w - 2} height={PH - 2} fill={p.c} />)}
  <rect width={W} height={H} fill="url(#planks-licht)" />
  <defs>
    <linearGradient id="planks-licht" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.08" />
      <stop offset="1" stop-color="#000" stop-opacity="0.22" />
    </linearGradient>
  </defs>
</svg>

<style>
  .planks { display: block; width: 100%; height: 100%; }
</style>
