---
/**
 * Kassel als klare Linienzeichnung fuer den Footer: links der Bergpark mit
 * Herkules, Kaskaden und Schloss Wilhelmshoehe, Hoehenlinien wie auf einer
 * Karte. Rechts die Stadt: Rathaus, Martinskirche, Fridericianum mit
 * Zwehrenturm, dazwischen moderne Bloecke, darunter die Spiegelung in der Fulda.
 * Die Linien werden beim Build erzeugt. Rein dekorativ, deshalb aria-hidden.
 */
import { linie, n, zufall } from '../lib/gravur';

const W = 1600;
const H = 440;
const HORIZONT = 332;

type Gipfel = [x: number, y: number, breite: number, form?: number];

/** Hoehenprofil: hoechster Gipfel gewinnt, glatt ohne Zittern. */
function kette(gipfel: Gipfel[]) {
  return (x: number) => {
    let h = 0;
    for (const [px, py, b, f = 2] of gipfel) h = Math.max(h, (HORIZONT - py) * Math.exp(-(Math.abs((x - px) / b) ** f)));
    return HORIZONT - h;
  };
}

const herkulesX = 300;
const ebenen = [
  { kamm: kette([[120, 250, 160], [620, 262, 220], [1050, 270, 260], [1450, 258, 220]]), abstand: 9, deckung: 0.4 },
  { kamm: kette([[herkulesX, 150, 210, 3], [700, 250, 170]]), abstand: 7, deckung: 0.65 },
];

/** Hoehenlinien: gleichmaessige Abstaende nach unten, laufen an der Basis aus. */
function hoehenlinien(kamm: (x: number) => number, abstand: number) {
  const out: string[] = [];
  for (let y0 = HORIZONT - abstand; y0 > 120; y0 -= abstand) {
    let seg: Array<[number, number]> = [];
    for (let x = 0; x <= W; x += 4) {
      const k = kamm(x);
      if (k < y0 - 1.5) {
        // Linie folgt dem Gelaende leicht
        seg.push([x, y0 + (y0 - k) * 0.08]);
      } else if (seg.length) {
        if (seg.length > 1) out.push(linie(seg));
        seg = [];
      }
    }
    if (seg.length > 1) out.push(linie(seg));
  }
  return out.join('');
}

const flaechen = ebenen.map((e) => {
  const pts: Array<[number, number]> = [];
  for (let x = 0; x <= W; x += 4) pts.push([x, e.kamm(x)]);
  return { flaeche: linie(pts) + `L${W} ${H}L0 ${H}Z`, kamm: linie(pts), linien: hoehenlinien(e.kamm, e.abstand), deckung: e.deckung };
});

/* --- Bergpark: Herkules (Oktogon, Pyramide, Figur), Kaskaden, Schloss --- */
const hb = ebenen[1].kamm(herkulesX) + 1;
const ow = 120, oh = 40;
const ox = herkulesX - ow / 2, oy = hb - oh;
const herk: string[] = [];
herk.push(`M${ox} ${hb}V${oy}H${ox + ow}V${hb}`, `M${ox - 4} ${oy}H${ox + ow + 4}M${ox} ${oy + 6}H${ox + ow}`);
for (let i = 0; i < 9; i++) {
  const bx = ox + 7 + i * 12.2;
  herk.push(`M${n(bx)} ${hb}V${oy + 20}A4 4 0 0 1 ${n(bx + 8)} ${oy + 20}V${hb}`);
}
const pyB = 46, pyH = 48, py = oy - 6;
herk.push(`M${herkulesX - 30} ${oy}V${py}H${herkulesX + 30}V${oy}`);
// Pyramide oben abgeflacht wie das Original, darauf ein gefuellter Sockel:
// So steht die Figur sichtbar auf dem Bau, statt ueber der Spitze zu schweben.
const pyT = 5;
const pyramide = `M${herkulesX - pyB / 2} ${py}L${herkulesX - pyT} ${py - pyH}H${herkulesX + pyT}L${herkulesX + pyB / 2} ${py}Z`;
herk.push(pyramide);
const sy = py - pyH;
const sockel = `M${herkulesX - 4} ${sy}V${sy - 5}H${herkulesX + 4}V${sy}Z`;
const figur = `M${herkulesX - 2.6} ${sy - 5}L${herkulesX - 2} ${sy - 15}L${herkulesX - 3.4} ${sy - 20}L${herkulesX} ${sy - 24}L${herkulesX + 3.2} ${sy - 20}L${herkulesX + 2.2} ${sy - 15}L${herkulesX + 2.8} ${sy - 5}Z`;

const kTop = hb + 2;
const kBot = HORIZONT - 22;
const kaskade: string[] = [`M${herkulesX - 5} ${kTop}L${herkulesX - 16} ${kBot}M${herkulesX + 5} ${kTop}L${herkulesX + 16} ${kBot}`];
for (let y = kTop + 5; y < kBot; y += 5) {
  const t = (y - kTop) / (kBot - kTop);
  const b = 5 + 11 * t;
  kaskade.push(`M${n(herkulesX - b)} ${y}H${n(herkulesX + b)}`);
}
const kaskadeFlaeche = `M${herkulesX - 5} ${kTop}H${herkulesX + 5}L${herkulesX + 16} ${kBot}H${herkulesX - 16}Z`;

// Schloss Wilhelmshoehe am Fuss der Kaskaden: Mittelbau mit Kuppel, zwei Fluegel
const sx = herkulesX, sb = HORIZONT;
const schlossFlaeche = `M${sx - 70} ${sb}V${sb - 16}H${sx - 24}V${sb - 24}H${sx + 24}V${sb - 16}H${sx + 70}V${sb}Z`;
const schlossLinien = [
  `M${sx - 70} ${sb}V${sb - 16}H${sx - 24}V${sb - 24}H${sx + 24}V${sb - 16}H${sx + 70}V${sb}`,
  `M${sx - 12} ${sb - 24}A12 9 0 0 1 ${sx + 12} ${sb - 24}M${sx} ${sb - 33}V${sb - 37}`,
];
for (let x = sx - 64; x < sx + 66; x += 6) {
  if (Math.abs(x - sx) < 22) continue;
  schlossLinien.push(`M${x} ${sb - 12}v6`);
}
for (let x = sx - 20; x <= sx + 20; x += 5) schlossLinien.push(`M${x} ${sb - 20}V${sb - 2}`);

/* --- Stadt --- */
interface Bau { flaeche: string; linien: string[]; }
const bauten: Bau[] = [];
const B = HORIZONT;

/** Moderner Block: Flachdach, Geschosslinien, ab und zu Fensterachsen. */
function block(x: number, w: number, h: number, achsen = 0) {
  const linien = [`M${x} ${B}V${B - h}H${x + w}V${B}`];
  for (let y = B - h + 6; y < B - 2; y += 6) linien.push(`M${x + 2} ${y}H${x + w - 2}`);
  for (let i = 1; i < achsen; i++) linien.push(`M${n(x + (w / achsen) * i)} ${B - h + 3}V${B - 2}`);
  bauten.push({ flaeche: `M${x} ${B}V${B - h}H${x + w}V${B}Z`, linien });
}

block(820, 34, 22, 3);
block(856, 22, 34);
// Rathaus: breiter Bau mit Mittelturm
{
  const x = 884, w = 112, h = 36;
  const linien = [`M${x} ${B}V${B - h}H${x + w}V${B}`, `M${x - 2} ${B - h}H${x + w + 2}`];
  for (let y = B - h + 8; y < B - 2; y += 8) linien.push(`M${x + 3} ${y}H${x + w - 3}`);
  for (let xx = x + 8; xx < x + w - 4; xx += 8) linien.push(`M${xx} ${B - h + 4}V${B - 3}`);
  const tx = x + w / 2;
  linien.push(`M${tx - 9} ${B - h}V${B - h - 34}H${tx + 9}V${B - h}`, `M${tx - 6} ${B - h - 34}V${B - h - 42}H${tx + 6}V${B - h - 34}`, `M${tx - 4} ${B - h - 42}Q${tx} ${B - h - 52} ${tx + 4} ${B - h - 42}M${tx} ${B - h - 49}V${B - h - 55}`);
  linien.push(`M${tx - 4} ${B - h - 26}h8v8h-8Z`);
  bauten.push({ flaeche: `M${x} ${B}V${B - h}H${tx - 9}V${B - h - 42}H${tx + 9}V${B - h}H${x + w}V${B}Z`, linien });
}
block(1000, 26, 48, 2);
// Martinskirche: Schiff mit Satteldach, zwei schlanke Tuerme mit Spitzhelm
{
  const x = 1032, w = 64;
  const linien = [`M${x} ${B}V${B - 26}L${x + w / 2} ${B - 44}L${x + w} ${B - 26}V${B}`];
  for (const tx of [x + 4, x + w - 16]) {
    linien.push(`M${tx} ${B}V${B - 84}H${tx + 12}V${B}`, `M${tx} ${B - 84}L${tx + 6} ${B - 128}L${tx + 12} ${B - 84}`, `M${tx + 4} ${B - 72}v8M${tx + 8} ${B - 72}v8`);
  }
  linien.push(`M${x + 26} ${B}V${B - 14}Q${x + 32} ${B - 22} ${x + 38} ${B - 14}V${B}`);
  bauten.push({
    flaeche: `M${x} ${B}V${B - 26}L${x + 4} ${B - 28}V${B - 84}L${x + 10} ${B - 128}L${x + 16} ${B - 84}V${B - 40}L${x + w - 16} ${B - 40}V${B - 84}L${x + w - 10} ${B - 128}L${x + w - 4} ${B - 84}V${B - 28}L${x + w} ${B - 26}V${B}Z`,
    linien,
  });
}
block(1102, 40, 28, 4);
// Fridericianum mit Saeulenportikus und Giebel, daneben der runde Zwehrenturm
{
  const x = 1150, w = 130, h = 30;
  const mx = x + w / 2;
  const linien = [`M${x} ${B}V${B - h}H${x + w}V${B}`, `M${x - 2} ${B - h}H${x + w + 2}M${x} ${B - h + 4}H${x + w}`];
  linien.push(`M${mx - 26} ${B - h}L${mx} ${B - h - 14}L${mx + 26} ${B - h}`);
  for (let i = 0; i < 6; i++) linien.push(`M${mx - 22 + i * 8.8} ${B - h + 5}V${B}`);
  for (let xx = x + 6; xx < mx - 28; xx += 9) linien.push(`M${xx} ${B - h + 10}v8`);
  for (let xx = mx + 32; xx < x + w - 4; xx += 9) linien.push(`M${xx} ${B - h + 10}v8`);
  const zx = x + w + 6;
  linien.push(`M${zx} ${B}V${B - 56}H${zx + 18}V${B}`, `M${zx - 2} ${B - 56}H${zx + 20}V${B - 60}H${zx - 2}Z`, `M${zx + 4} ${B - 45}h10M${zx + 4} ${B - 30}h10`);
  bauten.push({ flaeche: `M${x} ${B}V${B - h}H${mx - 26}L${mx} ${B - h - 14}L${mx + 26} ${B - h}H${x + w}V${B - h}H${zx}V${B - 60}H${zx + 20}V${B}Z`, linien });
}
block(1312, 30, 40, 3);
block(1346, 56, 24, 7);
block(1408, 24, 54, 2);
block(1436, 46, 30, 5);
block(1488, 30, 18);

/* --- Baeume hinter den Haeusern, damit die Skyline dicht wirkt --- */
const rb = zufall(2026);
const baeume: string[] = [];
for (let x = 812; x < 1530; x += 9 + rb() * 16) {
  const r = 5 + rb() * 8;
  const cy = B - 8 - r * (0.6 + rb() * 0.8);
  baeume.push(`M${n(x - r)} ${n(cy)}a${n(r)} ${n(r * 0.92)} 0 1 0 ${n(r * 2)} 0a${n(r)} ${n(r * 0.92)} 0 1 0 ${n(-r * 2)} 0Z`);
  baeume.push(`M${n(x - 1)} ${n(cy)}h2V${B}h-2Z`);
}

/* Stadt groesser und naeher: um den Fusspunkt skalieren, nach links ruecken */
const stadtTransform = `translate(540 ${B}) scale(1.45) translate(-820 ${-B})`;

/* --- Hintere Haeuserreihe: Daecher, Giebel, ein paar Spitzen, gibt Tiefe --- */
const rh = zufall(34);
const hinten: string[] = [];
for (let x = 520; x < W; ) {
  const w = 18 + rh() * 34;
  const h = 34 + rh() * 60;
  const art = rh();
  if (art < 0.45) hinten.push(`M${n(x)} ${B}V${n(B - h)}L${n(x + w / 2)} ${n(B - h - w * 0.45)}L${n(x + w)} ${n(B - h)}V${B}Z`);
  else if (art < 0.9) hinten.push(`M${n(x)} ${B}V${n(B - h)}H${n(x + w)}V${B}Z`);
  else hinten.push(`M${n(x)} ${B}V${n(B - h)}H${n(x + w / 2 - 3)}L${n(x + w / 2)} ${n(B - h - 40)}L${n(x + w / 2 + 3)} ${n(B - h)}H${n(x + w)}V${B}Z`);
  x += w - 2;
}
---

<svg class="panorama" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMinYMax slice" aria-hidden="true" focusable="false">
  <defs>
    <radialGradient id="pano-schein" cx="0.5" cy="0.8" r="0.6">
      <stop offset="0" stop-color="#B99B63" stop-opacity="0.34" />
      <stop offset="1" stop-color="#B99B63" stop-opacity="0" />
    </radialGradient>
    <linearGradient id="pano-wasser" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#fff" stop-opacity="0.55" />
      <stop offset="1" stop-color="#fff" stop-opacity="0" />
    </linearGradient>
    <mask id="pano-spiegel" maskUnits="userSpaceOnUse" x="0" y={B} width={W} height={H - B}>
      <rect x="0" y={B} width={W} height={H - B} fill="url(#pano-wasser)" />
      <g fill="#000">
        {Array.from({ length: 22 }, (_, k) => <rect x="0" y={B + 3 + k * 5 + k * k * 0.12} width={W} height={1.4 + k * 0.08} />)}
      </g>
    </mask>
    <g id="pano-stadt">
      <path class="panorama__gold" d={baeume.join('')} opacity="0.55" />
      {bauten.map((b) => <path class="panorama__gold" d={b.flaeche} />)}
      <path class="panorama__schnitt" d={bauten.flatMap((b) => b.linien.slice(1)).join('')} stroke-width="0.9" />
    </g>
  </defs>

  <!-- Bergpark im Hintergrund, nach hinten blasser -->
  {flaechen.map((f, i) => (
    <g>
      <path class="panorama__grund" d={f.flaeche} />
      <path class="panorama__gold" d={f.flaeche} opacity={i === 0 ? 0.05 : 0.1} />
      <path class="panorama__gold-strich" d={f.linien} stroke-width="0.6" opacity={i === 0 ? 0.18 : 0.3} />
      <path class="panorama__gold-strich" d={f.kamm} stroke-width="1" opacity={i === 0 ? 0.3 : 0.55} />
    </g>
  ))}
  <!-- Abendschein hinter der Stadt -->
  <ellipse cx="1080" cy={B} rx="620" ry="260" fill="url(#pano-schein)" />

  <g opacity="0.6">
    <path class="panorama__gold" d={kaskadeFlaeche} />
    <path class="panorama__schnitt" d={kaskade.join('')} stroke-width="0.8" />
    <path class="panorama__gold" d={`M${ox} ${hb}V${oy}H${ox + ow}V${hb}Z`} />
    <path class="panorama__gold" d={`M${herkulesX - 30} ${oy}V${py}H${herkulesX + 30}V${oy}Z`} />
    <path class="panorama__gold" d={pyramide} />
    <path class="panorama__schnitt" d={herk.slice(1).join('')} stroke-width="1" />
    <path class="panorama__gold" d={sockel} />
    <path class="panorama__gold" d={figur} />
    <circle class="panorama__gold" cx={herkulesX} cy={sy - 25.4} r="2.2" />
    <path class="panorama__gold" d={schlossFlaeche} />
    <path class="panorama__schnitt" d={schlossLinien.slice(1).join('')} stroke-width="0.9" />
  </g>

  <!-- Boden deckt die Huegelflaechen unter dem Horizont ab -->
  <path class="panorama__grund" d={`M0 ${B}H${W}V${H}H0Z`} />

  <!-- Stadt, darunter ihr Spiegelbild in der Fulda -->
  <path class="panorama__hinten" d={hinten.join('')} />
  <g transform={stadtTransform}><use href="#pano-stadt" /></g>
  <path class="panorama__gold" d={`M0 ${B - 1}H${W}V${B + 2}H0Z`} />
  <g mask="url(#pano-spiegel)" opacity="0.5">
    <g transform={`translate(0 ${2 * B}) scale(1 -1)`}>
      <path class="panorama__hinten" d={hinten.join('')} />
      <g transform={stadtTransform}><use href="#pano-stadt" /></g>
      <path class="panorama__gold" d={`M${ox} ${hb}V${oy}H${ox + ow}V${hb}Z`} opacity="0.35" />
    </g>
  </g>
</svg>

<style>
  .panorama { color: var(--color-primary); display: block; width: 100%; height: clamp(13rem, 30vw, 28rem); }
  .panorama__grund { fill: var(--color-petrol); }
  .panorama__gold { fill: currentColor; }
  /* Gold zu 32 % auf Graphit, deckend, damit die Huegellinien nicht durchscheinen */
  .panorama__hinten { fill: #4E4636; }
  .panorama__gold-strich { fill: none; stroke: currentColor; stroke-linecap: round; stroke-linejoin: round; }
  /* Fenster und Kanten als Aussparung in der Goldflaeche */
  .panorama__schnitt { fill: none; stroke: var(--color-petrol); stroke-linecap: round; stroke-linejoin: round; }
</style>
