---
/**
 * Kassel als Kupferstich fuer den Footer: Habichtswald mit Herkules und
 * Kaskaden links, Stadt mit den Tuermen der Martinskirche am Horizont rechts,
 * davor Feld und Gras. Ein Fensterputzer mit Leiter und Eimer laeuft Richtung
 * Stadt. Die Linien werden beim Build erzeugt (src/lib/gravur.ts).
 * Rein dekorativ, deshalb aria-hidden.
 */
import { linie, n, welle, zufall } from '../lib/gravur';

const W = 1600;
const H = 440;
const HORIZONT = 318;
const r = zufall(1913);

type Gipfel = [x: number, y: number, breite: number, form?: number];

/** Hoehenlinie einer Bergkette: hoechster Gipfel gewinnt, dazu leichtes Zittern. */
function kette(gipfel: Gipfel[], basis: number, amp: number) {
  const w = welle(r, amp);
  return (x: number) => {
    let h = 0;
    for (const [px, py, b, f = 2] of gipfel) h = Math.max(h, (basis - py) * Math.exp(-(Math.abs((x - px) / b) ** f)));
    return basis - h + (h > 2 ? w(x) : 0);
  };
}

interface Ebene { kamm: (x: number) => number; basis: number; linien: number; }

const herkulesX = 380;
const ebenen: Ebene[] = [
  {
    // ferne Kette, nur angedeutet
    kamm: kette([[150, 222, 120], [560, 236, 160], [760, 214, 110], [1040, 226, 150], [1260, 206, 120], [1520, 220, 140]], HORIZONT, 3),
    basis: HORIZONT,
    linien: 16,
  },
  {
    // Habichtswald, Herkules auf dem Karlsberg
    kamm: kette([[herkulesX, 150, 200, 3], [90, 246, 130], [640, 232, 110], [930, 240, 170], [1250, 222, 200], [1560, 250, 120]], HORIZONT, 2.6),
    basis: HORIZONT,
    linien: 38,
  },
  {
    // vordere Huegel
    kamm: kette([[230, 286, 190], [800, 284, 230], [1450, 288, 200]], HORIZONT, 1.4),
    basis: HORIZONT,
    linien: 10,
  },
];
const HERKULES_EBENE = 1;
const flaechen: string[] = [];
const kaemme: string[] = [];
const schraffenJe: string[] = [];
const schattenJe: string[] = [];

for (const e of ebenen) {
  const schraffen: string[] = [];
  const schatten: string[] = [];
  const kammPts: Array<[number, number]> = [];
  for (let x = 0; x <= W; x += 4) kammPts.push([x, e.kamm(x)]);
  flaechen.push(linie(kammPts) + `L${W} ${H}L0 ${H}Z`);
  kaemme.push(linie(kammPts));

  // Hoehenlinien: folgen dem Kamm und laufen zur Basis hin flach aus.
  for (let k = 1; k <= e.linien; k++) {
    const t = (k / (e.linien + 1)) ** 1.35;
    const w = welle(r, 0.8);
    let seg: Array<[number, number]> = [];
    let rest = 20 + r() * 140;
    for (let x = 0; x <= W; x += 5) {
      const kamm = e.kamm(x);
      const hoehe = e.basis - kamm;
      const y = kamm + hoehe * t + w(x) * t;
      rest -= 5;
      const sichtbar = hoehe > 6 && y < e.basis - 1;
      if (!sichtbar || rest < 0) {
        if (seg.length > 1) schraffen.push(linie(seg));
        seg = [];
        if (rest < 0) rest = 30 + r() * 160;
        if (!sichtbar) continue;
        // kleine Luecke im Strich
        x += r() < 0.5 ? 5 : 0;
        continue;
      }
      seg.push([x, y]);
    }
    if (seg.length > 1) schraffen.push(linie(seg));
  }

  // Schattenseite (Licht von links): kurze Zusatzstriche, wo der Hang nach rechts abfaellt.
  for (let x = 6; x < W; x += 7 + r() * 4) {
    const kamm = e.kamm(x);
    const steig = (e.kamm(x + 4) - e.kamm(x - 4)) / 8;
    const hoehe = e.basis - kamm;
    if (steig < 0.12 || hoehe < 14) continue;
    const len = Math.min(hoehe * 0.75, 10 + steig * 70);
    const y0 = kamm + 3 + r() * 4;
    schatten.push(`M${n(x)} ${n(y0)}L${n(x - 3 - steig * 4)} ${n(y0 + len)}`);
  }
  schraffenJe.push(schraffen.join(''));
  schattenJe.push(schatten.join(''));
}

/* --- Herkules: Oktogon, Pyramide, Figur, darunter die Kaskaden --- */
const hb = ebenen[HERKULES_EBENE].kamm(herkulesX) + 2; // Fuss des Oktogons
const ok = { w: 74, h: 24 };
const herk: string[] = [];
const herkFlaeche: string[] = [];
const ox = herkulesX - ok.w / 2;
const oy = hb - ok.h;
herkFlaeche.push(`M${n(ox)} ${n(hb)}L${n(ox)} ${n(oy)}L${n(ox + ok.w)} ${n(oy)}L${n(ox + ok.w)} ${n(hb)}Z`);
herk.push(`M${n(ox - 3)} ${n(oy)}L${n(ox + ok.w + 3)} ${n(oy)}`); // Gesims
herk.push(`M${n(ox - 1)} ${n(oy + 4)}L${n(ox + ok.w + 1)} ${n(oy + 4)}`);
herk.push(`M${n(ox)} ${n(oy)}L${n(ox)} ${n(hb)}M${n(ox + ok.w)} ${n(oy)}L${n(ox + ok.w)} ${n(hb)}`);
// Bogenreihe
for (let i = 0; i < 7; i++) {
  const bx = ox + 5 + i * 9.6;
  herk.push(`M${n(bx)} ${n(hb)}L${n(bx)} ${n(oy + 12)}A3.4 3.4 0 0 1 ${n(bx + 6.8)} ${n(oy + 12)}L${n(bx + 6.8)} ${n(hb)}`);
}
// Schatten rechts am Oktogon
for (let x = ox + ok.w * 0.62; x < ox + ok.w; x += 2.2) herk.push(`M${n(x)} ${n(oy + 5)}L${n(x)} ${n(hb)}`);
// Pyramide und Sockel
const py = oy - 3;
herkFlaeche.push(`M${n(herkulesX - 15)} ${n(py)}L${n(herkulesX)} ${n(py - 30)}L${n(herkulesX + 15)} ${n(py)}Z`);
herk.push(`M${n(ox + 18)} ${n(oy)}L${n(ox + 18)} ${n(py)}L${n(ox + ok.w - 18)} ${n(py)}L${n(ox + ok.w - 18)} ${n(oy)}`);
herk.push(`M${n(herkulesX - 15)} ${n(py)}L${n(herkulesX)} ${n(py - 30)}L${n(herkulesX + 15)} ${n(py)}`);
for (let i = 1; i < 9; i++) {
  const t = i / 9;
  const yy = py - 30 * (1 - t);
  herk.push(`M${n(herkulesX + 1)} ${n(yy)}L${n(herkulesX + 15 * t)} ${n(yy)}`);
}
const sy = py - 30;
herk.push(`M${n(herkulesX - 2.5)} ${n(sy)}L${n(herkulesX - 2.5)} ${n(sy - 3)}L${n(herkulesX + 2.5)} ${n(sy - 3)}L${n(herkulesX + 2.5)} ${n(sy)}`);
// Herkules: Figur mit Keule
const herkFigur = `M${n(herkulesX - 1.6)} ${n(sy - 3)}L${n(herkulesX - 1.2)} ${n(sy - 9)}L${n(herkulesX - 2.2)} ${n(sy - 12)}L${n(herkulesX)} ${n(sy - 14.5)}L${n(herkulesX + 2)} ${n(sy - 12)}L${n(herkulesX + 1.4)} ${n(sy - 9)}L${n(herkulesX + 1.8)} ${n(sy - 3)}Z`;
const herkKopf = { x: herkulesX, y: sy - 15.6 };
herk.push(`M${n(herkulesX + 1.8)} ${n(sy - 11)}L${n(herkulesX + 4)} ${n(sy - 5)}`);

// Kaskaden: Treppe den Hang hinunter, unten breiter
const kaskadeTop = hb + 3;
const kaskadeBot = ebenen[HERKULES_EBENE + 1].kamm(herkulesX + 30) - 2;
const kaskade: string[] = [];
const stufen = 26;
for (let i = 0; i <= stufen; i++) {
  const t = i / stufen;
  const y = kaskadeTop + (kaskadeBot - kaskadeTop) * t ** 1.15;
  const b = 4 + 9 * t;
  kaskade.push(`M${n(herkulesX - b)} ${n(y)}L${n(herkulesX + b)} ${n(y)}`);
}
kaskade.push(`M${n(herkulesX - 4)} ${n(kaskadeTop)}L${n(herkulesX - 13)} ${n(kaskadeBot)}M${n(herkulesX + 4)} ${n(kaskadeTop)}L${n(herkulesX + 13)} ${n(kaskadeBot)}`);
const kaskadeFlaeche = `M${n(herkulesX - 4)} ${n(kaskadeTop)}L${n(herkulesX + 4)} ${n(kaskadeTop)}L${n(herkulesX + 13)} ${n(kaskadeBot)}L${n(herkulesX - 13)} ${n(kaskadeBot)}Z`;

/* --- Stadt am Horizont mit den zwei Tuermen der Martinskirche --- */
const stadt: string[] = [];
const stadtFlaeche: string[] = [];
let sx = 1010;
while (sx < 1330) {
  const b = 9 + r() * 14;
  const h = 6 + r() * 9;
  const dach = 3 + r() * 6;
  const y0 = HORIZONT + 1;
  const umriss = `M${n(sx)} ${n(y0)}L${n(sx)} ${n(y0 - h)}L${n(sx + b / 2)} ${n(y0 - h - dach)}L${n(sx + b)} ${n(y0 - h)}L${n(sx + b)} ${n(y0)}`;
  stadtFlaeche.push(umriss + 'Z');
  stadt.push(umriss);
  if (b > 13 && r() < 0.6) stadt.push(`M${n(sx + b * 0.3)} ${n(y0 - h + 3)}l0 2M${n(sx + b * 0.65)} ${n(y0 - h + 3)}l0 2`);
  sx += b + (r() < 0.3 ? 2 : 0);
}
for (const tx of [1152, 1168]) {
  const y0 = HORIZONT + 1;
  const turm = `M${n(tx - 4)} ${n(y0)}L${n(tx - 4)} ${n(y0 - 30)}L${n(tx)} ${n(y0 - 44)}L${n(tx + 4)} ${n(y0 - 30)}L${n(tx + 4)} ${n(y0)}`;
  stadtFlaeche.push(turm + 'Z');
  stadt.push(turm, `M${n(tx - 4)} ${n(y0 - 30)}L${n(tx + 4)} ${n(y0 - 30)}`, `M${n(tx - 1.2)} ${n(y0 - 26)}l0 4M${n(tx + 1.2)} ${n(y0 - 26)}l0 4`);
  for (let x = tx + 0.8; x < tx + 4; x += 1.4) stadt.push(`M${n(x)} ${n(y0 - 29)}L${n(x)} ${n(y0)}`);
}
stadtFlaeche.push(`M${n(1159)} ${n(HORIZONT + 1)}L${n(1159)} ${n(HORIZONT - 20)}L${n(1161)} ${n(HORIZONT - 20)}L${n(1161)} ${n(HORIZONT + 1)}Z`);

/* --- Feld: waagerechte Linien, nach vorn weiter auseinander --- */
const feld: string[] = [];
const FELD_LINIEN = 30;
for (let k = 0; k < FELD_LINIEN; k++) {
  const t = k / FELD_LINIEN;
  const y = HORIZONT + 1 + (H - HORIZONT) * t ** 1.7;
  const w = welle(r, 0.4 + t * 1.6);
  let seg: Array<[number, number]> = [];
  let rest = 30 + r() * 200;
  let luecke = 0;
  for (let x = -10; x <= W + 10; x += 6) {
    if (luecke > 0) { luecke -= 6; continue; }
    seg.push([x, y + w(x)]);
    rest -= 6;
    if (rest < 0) {
      if (seg.length > 1) feld.push(linie(seg));
      seg = [];
      rest = 40 + r() * (220 - t * 120);
      luecke = 6 + r() * (60 - t * 40);
    }
  }
  if (seg.length > 1) feld.push(linie(seg));
}

/* --- Gras: Bueschel, vorn groesser und dichter --- */
const gras: string[] = [];
const grasDunkel: string[] = [];
for (let i = 0; i < 240; i++) {
  const t = r() ** 0.55;
  const y = HORIZONT + 12 + (H - HORIZONT - 6) * t;
  const x = r() * W;
  // Freiraum um den Fensterputzer
  if (Math.abs(x - 660) < 46 && y > 360 && y < 420) continue;
  const s = 0.35 + t * 1.5;
  const halme = 4 + Math.floor(r() * 6);
  const ziel = t > 0.7 && r() < 0.5 ? grasDunkel : gras;
  for (let h = 0; h < halme; h++) {
    const fx = x + (r() - 0.5) * 8 * s;
    const lean = (r() - 0.5) * 14 * s;
    const len = (6 + r() * 11) * s;
    ziel.push(`M${n(fx)} ${n(y)}Q${n(fx + lean * 0.2)} ${n(y - len * 0.6)} ${n(fx + lean)} ${n(y - len)}`);
  }
}

/* --- Fensterputzer mit Leiter und Eimer, laeuft nach rechts --- */
const fp = { x: 660, y: 398, s: 1.15 };
const leiter: string[] = [];
const lA: [number, number] = [-32, -33];
const lB: [number, number] = [30, -45];
const lN = (() => {
  const dx = lB[0] - lA[0], dy = lB[1] - lA[1];
  const l = Math.hypot(dx, dy);
  return [(-dy / l) * 3.4, (dx / l) * 3.4];
})();
leiter.push(`M${lA[0]} ${lA[1]}L${lB[0]} ${lB[1]}`);
leiter.push(`M${n(lA[0] + lN[0])} ${n(lA[1] + lN[1])}L${n(lB[0] + lN[0])} ${n(lB[1] + lN[1])}`);
for (let i = 1; i < 10; i++) {
  const t = i / 10;
  const x = lA[0] + (lB[0] - lA[0]) * t;
  const y = lA[1] + (lB[1] - lA[1]) * t;
  leiter.push(`M${n(x)} ${n(y)}l${n(lN[0])} ${n(lN[1])}`);
}
---

<svg class="panorama" viewBox={`0 0 ${W} ${H}`} preserveAspectRatio="xMinYMax slice" aria-hidden="true" focusable="false">
  <g class="panorama__linie">
    {ebenen.map((_, i) => (
      <g>
        <path class="panorama__flaeche" d={flaechen[i]} />
        <path class="panorama__kamm" d={kaemme[i]} opacity={i === 0 ? 0.55 : 1} />
        <path d={schraffenJe[i]} stroke-width="0.75" opacity={i === 0 ? 0.45 : 0.9} />
        <path d={schattenJe[i]} stroke-width="0.6" opacity={i === 0 ? 0.4 : 0.75} />
        {i === HERKULES_EBENE && (
          <g>
            <path class="panorama__flaeche" d={kaskadeFlaeche} />
            <path d={kaskade.join('')} stroke-width="0.7" />
            <g transform={`translate(${herkulesX} ${hb}) scale(1.7) translate(${-herkulesX} ${-hb})`}>
              {herkFlaeche.map((d) => <path class="panorama__flaeche" d={d} />)}
              <path d={herk.join('')} stroke-width="0.6" />
              <path class="panorama__voll" d={herkFigur} />
              <circle class="panorama__voll" cx={herkKopf.x} cy={herkKopf.y} r="1.3" />
            </g>
          </g>
        )}
      </g>
    ))}

    <!-- Feld deckt die Fuesse der Huegel ab -->
    <path class="panorama__flaeche" d={`M0 ${HORIZONT}L${W} ${HORIZONT}L${W} ${H}L0 ${H}Z`} />
    {stadtFlaeche.map((d) => <path class="panorama__flaeche" d={d} />)}
    <path d={stadt.join('')} stroke-width="0.7" />
    <path d={feld.join('')} stroke-width="0.7" opacity="0.75" />
    <path d={gras.join('')} stroke-width="0.8" opacity="0.8" />
    <path d={grasDunkel.join('')} stroke-width="1.1" />

    <g transform={`translate(${fp.x} ${fp.y}) scale(${fp.s})`}>
      <path d="M-14 0.5Q0 3 16 0.5" stroke-width="0.6" opacity="0.7" />
      <path d={leiter.join('')} stroke-width="1.1" />
      <!-- Beine im Schritt -->
      <path d="M1 -20L-6 -9L-9 0M3 -20L6 -10L11 -1" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" />
      <!-- Koerper -->
      <path class="panorama__voll" d="M-4 -36Q0 -38 5 -36L5.5 -20L-2.5 -20Z" />
      <circle class="panorama__voll" cx="1.5" cy="-41.5" r="4" />
      <!-- Muetze -->
      <path class="panorama__voll" d="M-2.6 -42.5Q1.5 -48 5.6 -42.5Z" />
      <path d="M5.6 -42.5L8 -42.2" stroke-width="1.2" stroke-linecap="round" />
      <!-- Arm an der Leiter -->
      <path d="M4 -34L10 -38.5L13 -42" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      <!-- Arm mit Eimer -->
      <path d="M-2 -34L-4.5 -27L-5 -22" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
      <path class="panorama__voll" d="M-9.2 -19L-0.8 -19L-2 -11L-8 -11Z" />
      <path d="M-9 -19Q-5 -25 -1 -19" stroke-width="0.8" />
    </g>
  </g>
</svg>

<style>
  .panorama { color: var(--color-primary); display: block; width: 100%; height: clamp(12rem, 27.5vw, 26rem); }
  .panorama__linie { fill: none; stroke: currentColor; stroke-linecap: round; }
  .panorama__flaeche { fill: var(--gravur-grund, var(--color-petrol)); stroke: none; }
  .panorama__kamm { stroke-width: 1.3; }
  .panorama__voll { fill: currentColor; stroke: none; }
</style>
