---
/**
 * Reviews – Kundenbewertungen über Bewertungsflow.
 *
 * Das Widget ist ein Script, kein iframe: jedes Script-Tag rendert an seiner
 * Position eine Instanz. `is:inline` ist zwingend, sonst wuerde Astro das
 * Script buendeln und die data-Attribute gingen verloren.
 *
 *   <Reviews />                      → Karussell (Bewertungsliste)
 *   <Reviews widgetStyle="badge" />  → kompaktes Badge, z. B. im Hero
 *
 * DATENSCHUTZ: laedt von app.bewertungen.de und uebertraegt damit die
 * IP der Besucher an einen Drittanbieter → gehoert in die Datenschutzerklaerung.
 */
import { bewertungen } from '../data/site';

interface Props {
  widgetStyle?: 'carousel' | 'badge';
  token?: string;
  theme?: string;
  class?: string;
}

const {
  widgetStyle = 'carousel',
  token = bewertungen.token,
  theme = bewertungen.theme,
  class: className = '',
} = Astro.props;
---

<div class={`reviews reviews--${widgetStyle} ${className}`}>
  <script
    is:inline
    src={bewertungen.scriptUrl}
    data-token={token}
    data-style={widgetStyle}
    data-theme={theme}></script>

  <noscript>
    <p class="reviews__noscript">
      Unsere Kundenbewertungen werden über Bewertungsflow angezeigt. Bitte
      aktivieren Sie JavaScript, um sie zu sehen.
    </p>
  </noscript>
</div>

<style>
  .reviews--carousel {
    /* Das Widget bringt eigene Breite mit; hier nur die Buehne begrenzen */
    max-width: 68rem;
    margin-inline: auto;
    /* Reserviert Platz, damit beim Nachladen nichts springt (CLS) */
    min-height: 16rem;
  }

  .reviews--badge {
    display: inline-block;
    min-height: 3rem;
  }

  .reviews__noscript {
    font-size: var(--size-small);
    color: var(--color-text-muted);
  }
</style>
