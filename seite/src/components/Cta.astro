---
/**
 * Cta – der Angebots-Button. EINE Komponente für alle Platzierungen.
 * Konvention (HANDOVER §8): Text "Kostenloses Angebot anfordern",
 * Ziel site.angebotUrl, Radius aus --radius, zentriert –
 * außer im Hero (dort linksbündig neben dem Bild).
 */
import { site } from '../data/site';

interface Props {
  /** Abweichender Beschriftungstext */
  label?: string;
  href?: string;
  /** 'center' (default) | 'start' – Hero nutzt 'start' */
  align?: 'center' | 'start';
  variant?: 'primary' | 'ghost';
  class?: string;
}

const {
  label = site.ctaLabel,
  href = site.angebotUrl,
  align = 'center',
  variant = 'primary',
  class: className = '',
} = Astro.props;

const external = href.startsWith('http');
---

<div class={`cta cta--${align} ${className}`}>
  <a
    class={`cta__btn cta__btn--${variant} lift`}
    href={href}
    rel={external ? 'noopener' : undefined}
  >
    {label}
  </a>
  <slot />
</div>

<style>
  .cta { display: flex; flex-direction: column; gap: var(--space-2); }
  .cta--center { align-items: center; text-align: center; }
  .cta--start { align-items: flex-start; }

  .cta__btn {
    display: inline-block;
    padding: 0.9rem 1.75rem;
    border-radius: var(--radius);
    font-weight: var(--weight-bold);
    text-decoration: none;
    box-shadow: var(--shadow-sm);
  }

  .cta__btn--primary {
    background: var(--color-primary);
    color: var(--color-primary-contrast);
  }
  .cta__btn--primary:hover {
    background: var(--color-primary-hover);
    color: var(--color-primary-contrast);
    box-shadow: var(--shadow);
  }

  .cta__btn--ghost {
    background: transparent;
    color: var(--color-petrol);
    border: 2px solid var(--color-petrol);
  }
  .cta__btn--ghost:hover {
    background: var(--color-petrol);
    color: #fff;
  }
</style>
