---
/**
 * Faq – Akkordeon + FAQPage-Schema in einem. Ersetzt das Divi-Modul `dsm_faq`.
 * Das Schema wird aus denselben Daten erzeugt wie die sichtbare Ausgabe,
 * damit Markup und strukturierte Daten nie auseinanderlaufen.
 *
 *   <Faq items={[{ q: '…', a: '…' }]} />
 */
export interface FaqItem {
  q: string;
  a: string;
}

interface Props {
  items: FaqItem[];
  /** Ohne Angabe wird KEINE Überschrift gerendert – die liefert meist
   *  schon die umgebende Section, sonst stünde sie doppelt da. */
  title?: string;
  /** Erstes Element offen zeigen */
  openFirst?: boolean;
}

const { items, title, openFirst = false } = Astro.props;

const schema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: items.map((i) => ({
    '@type': 'Question',
    name: i.q,
    acceptedAnswer: { '@type': 'Answer', text: i.a },
  })),
};
---

<div class="faq">
  {title && <h2 class="faq__title">{title}</h2>}

  <div class="faq__list stagger">
    {
      items.map((item, idx) => (
        <details class="faq__item reveal" open={openFirst && idx === 0}>
          <summary class="faq__q">
            <span>{item.q}</span>
            <svg class="faq__icon" viewBox="0 0 20 20" aria-hidden="true" width="20" height="20">
              <path
                d="M5 7.5 10 12.5 15 7.5"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              />
            </svg>
          </summary>
          <div class="faq__a">
            <p>{item.a}</p>
          </div>
        </details>
      ))
    }
  </div>
</div>

<script type="application/ld+json" set:html={JSON.stringify(schema)} is:inline />

<style>
  .faq__title { margin-bottom: var(--space-6); }

  .faq__item {
    background: #fff;
    border: 1px solid var(--color-border);
    border-radius: var(--radius);
    overflow: hidden;
  }
  .faq__item + .faq__item { margin-top: var(--space-3); }

  .faq__q {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding: var(--space-4);
    cursor: pointer;
    font-weight: var(--weight-bold);
    color: var(--color-heading);
    list-style: none;
  }
  .faq__q::-webkit-details-marker { display: none; }

  /* Icon dreht sich – nur transform, 150ms, ease-out */
  .faq__icon {
    flex: none;
    color: var(--color-primary);
    transition: transform var(--duration-fast) var(--ease-out-soft);
  }
  .faq__item[open] .faq__icon { transform: rotate(180deg); }

  .faq__a {
    padding: 0 var(--space-4) var(--space-4);
    color: var(--color-text);
  }

  @media (prefers-reduced-motion: reduce) {
    .faq__icon { transition: none; }
  }
</style>
