---
/**
 * Aufmass: der Hero-Grundriss. Ein gezeichneter Plan (Haus, Wintergarten,
 * Terrasse, Garten), links hell (Reinigung), rechts dunkel (Handwerk). Jede
 * Leistung ist ein Link-Chip an ihrem Bauteil. Der Plan wird einmal gezeichnet
 * und zweimal mit Clip eingesetzt, damit die Linien die Farbe wechseln.
 * Ab 860 px Breite sichtbar, darunter uebernehmen die Bereichskarten.
 */
import { leistung, bereiche } from '../data/leistungen';
import { internalLink, registry } from '../data/pages';
import Icon from './Icon.astro';

type Chip = { slug: string; x: number; y: number; zone?: string; bereich: 'reinigung' | 'handwerk' | 'hausmeister' };

const chips: Chip[] = [
  { slug: '/fensterreinigung-kassel/', x: 420, y: 56, zone: 'z-winter', bereich: 'reinigung' },
  { slug: '/wintergartenreinigung-kassel/', x: 410, y: 220, zone: 'z-winter', bereich: 'reinigung' },
  { slug: '/steinreinigung-kassel/', x: 262, y: 305, zone: 'z-terrasse', bereich: 'reinigung' },
  { slug: '/gartenpflege-kassel/', x: 50, y: 175, zone: 'z-garten', bereich: 'hausmeister' },
  { slug: '/winterdienst-kassel/', x: 40, y: 405, zone: 'z-weg', bereich: 'hausmeister' },
  { slug: '/fassadenreinigung-kassel/', x: 640, y: 56, bereich: 'reinigung' },
  { slug: '/grundreinigung-kassel/', x: 630, y: 196, zone: 'z-wohnen', bereich: 'reinigung' },
  { slug: '/streichen-tapezieren-kassel/', x: 630, y: 250, bereich: 'handwerk' },
  { slug: '/boden-verlegen-kassel/', x: 630, y: 305, zone: 'z-boden', bereich: 'handwerk' },
  { slug: '/kuechenmontage-moebelmontage-kassel/', x: 640, y: 140, zone: 'z-kueche', bereich: 'handwerk' },
  { slug: '/fliegengitter-kassel/', x: 930, y: 56, zone: 'z-schlafen', bereich: 'handwerk' },
  { slug: '/plissees-kassel/', x: 690, y: 392, bereich: 'handwerk' },
  { slug: '/entruempelung-kassel/', x: 1005, y: 310, zone: 'z-abstell', bereich: 'hausmeister' },
];

// Bodenbelag: diagonale Schraffur, zugeschnitten auf die Wohnflaeche
const schraffur = Array.from({ length: 20 }, (_, i) => 610 + i * 20);
const pavers = {
  v: [290, 330],
  h: [190, 230, 270, 310],
};
const label = (slug: string) => registry[slug].label;
---

<div class="aufmass" data-anim="aufmass">
  <div class="aufmass__stage">
    <svg viewBox="0 0 1200 440" class="aufmass__svg" role="img" aria-labelledby="aufmass-titel" preserveAspectRatio="xMidYMid meet">
      <title id="aufmass-titel">Grundriss eines Hauses mit Wintergarten, Terrasse und Garten. Links die Gebäudereinigung, rechts das Handwerk.</title>
      <defs>
        <clipPath id="clip-l"><rect x="0" y="0" width="600" height="440" /></clipPath>
        <clipPath id="clip-r"><rect x="600" y="0" width="600" height="440" /></clipPath>
        <clipPath id="clip-boden"><rect x="610" y="200" width="262" height="162" /></clipPath>

        <g id="plan-g" fill="none" stroke="currentColor" stroke-linecap="square" stroke-linejoin="miter">
          <!-- Aussenwand: Kopf und Fuss mit Fensterluecken, rechte Wand mit Fenster -->
          <g stroke-width="3">
            <path d="M600 80H660M780 80H1140V120M1140 190V370H800M700 370H600" />
            <path d="M600 80V200M600 250V370" />
            <path d="M880 80V170M880 210V300M880 340V370" />
            <path d="M880 250H920M960 250H1050M1090 250H1140" />
            <path d="M1010 250V370" />
          </g>
          <!-- Fenster: doppelte Linie in der Luecke -->
          <g stroke-width="1.2">
            <path d="M660 77H780M660 83H780M660 80H780" />
            <path d="M1137 120V190M1143 120V190M1140 120V190" />
            <path d="M700 367H800M700 373H800M700 370H800" />
          </g>
          <!-- Wintergarten: Glas, doppelte Kontur, Sparren -->
          <g stroke-width="2">
            <rect x="380" y="80" width="220" height="290" />
            <rect x="386" y="86" width="208" height="278" stroke-width="1" />
          </g>
          <g stroke-width="1" stroke-dasharray="6 6">
            <path d="M435 86V364M490 86V364M545 86V364" />
          </g>
          <!-- Tueren -->
          <g stroke-width="1">
            <path d="M600 250H650M650 250A50 50 0 0 0 600 200" />
            <path d="M880 210H920M920 210A40 40 0 0 1 880 170" />
            <path d="M880 340H910M910 340A30 30 0 0 0 880 310" />
          </g>
          <!-- Kueche -->
          <g stroke-width="1.5">
            <rect x="610" y="90" width="260" height="30" />
            <circle cx="670" cy="105" r="7" />
            <circle cx="700" cy="105" r="7" />
            <rect x="780" y="96" width="50" height="18" />
            <rect x="700" y="160" width="130" height="24" />
          </g>
          <!-- Boden: Schraffur -->
          <g clip-path="url(#clip-boden)" stroke-width="1" opacity="0.55">
            {schraffur.map((x) => <path d={`M${x} 362L${x + 162} 200`} />)}
          </g>
          <!-- Schlafen -->
          <g stroke-width="1.5">
            <rect x="920" y="110" width="100" height="110" />
            <rect x="930" y="116" width="36" height="20" />
            <rect x="974" y="116" width="36" height="20" />
            <rect x="1060" y="96" width="60" height="140" stroke-width="1" />
          </g>
          <!-- Bad -->
          <g stroke-width="1.5">
            <rect x="892" y="262" width="108" height="30" />
            <circle cx="906" cy="338" r="10" />
            <rect x="896" y="350" width="20" height="12" />
            <circle cx="962" cy="340" r="11" />
          </g>
          <!-- Abstellraum -->
          <g stroke-width="1.5">
            <rect x="1020" y="262" width="110" height="20" />
            <rect x="1030" y="328" width="30" height="30" />
            <rect x="1072" y="338" width="46" height="20" />
          </g>
          <!-- Terrasse -->
          <g stroke-width="1.5">
            <rect x="250" y="150" width="130" height="200" />
          </g>
          <g stroke-width="1" opacity="0.6">
            {pavers.v.map((x) => <path d={`M${x} 150V350`} />)}
            {pavers.h.map((y) => <path d={`M250 ${y}H380`} />)}
          </g>
          <!-- Garten -->
          <g stroke-width="1.5">
            <circle cx="96" cy="120" r="28" />
            <circle cx="96" cy="120" r="9" stroke-width="1" />
            <circle cx="170" cy="318" r="20" />
            <circle cx="170" cy="318" r="6" stroke-width="1" />
            <circle cx="58" cy="290" r="15" />
          </g>
          <g stroke-width="1" stroke-dasharray="3 7">
            <path d="M20 60H250V150M20 60V380H250V350" />
          </g>
          <!-- Weg -->
          <g stroke-width="1.2">
            <path d="M20 392H360M20 422H360" />
          </g>
          <!-- Masslinie -->
          <g stroke-width="1">
            <path d="M380 428H1140M380 421V435M1140 421V435" />
          </g>
          <text x="1000" y="418" text-anchor="middle" class="aufmass__dim" fill="currentColor" stroke="none">7,60 m</text>
        </g>
      </defs>

      <g class="aufmass__zonen" fill="var(--color-primary)">
        <rect id="z-winter" x="380" y="80" width="220" height="290" />
        <rect id="z-terrasse" x="250" y="150" width="130" height="200" />
        <rect id="z-garten" x="20" y="60" width="230" height="320" />
        <rect id="z-weg" x="20" y="392" width="340" height="30" />
        <rect id="z-wohnen" x="600" y="80" width="280" height="290" />
        <rect id="z-boden" x="610" y="200" width="262" height="162" />
        <rect id="z-kueche" x="610" y="90" width="260" height="30" />
        <rect id="z-schlafen" x="880" y="80" width="260" height="170" />
        <rect id="z-abstell" x="1010" y="250" width="130" height="120" />
      </g>

      <use href="#plan-g" class="plan plan--hell" clip-path="url(#clip-l)" />
      <use href="#plan-g" class="plan plan--dunkel" clip-path="url(#clip-r)" />
    </svg>

    <ul class="aufmass__chips">
      {
        chips.map((c) => (
          <li style={`--x:${c.x / 12}%; --y:${c.y / 4.4}%;`} data-anim="chip">
            <a href={internalLink(c.slug).href} class={`chip chip--${c.bereich}`} data-zone={c.zone}>
              <Icon name={leistung[c.slug].icon} size={16} />
              <span>{label(c.slug)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</div>

<style>
  .aufmass {
    container-type: inline-size;
    background: linear-gradient(to right, #fff 50%, var(--color-petrol) 50%);
    padding-block: var(--space-8) var(--space-12);
  }
  .aufmass__stage {
    position: relative;
    max-width: var(--container-max);
    margin-inline: auto;
    aspect-ratio: 1200 / 440;
  }
  .aufmass__svg { position: absolute; inset: 0; width: 100%; height: 100%; overflow: visible; }

  .plan--hell { color: var(--color-petrol); }
  .plan--dunkel { color: var(--color-primary); }
  .aufmass__dim { font: 600 11px var(--font-body); letter-spacing: 0.06em; }

  .aufmass__zonen rect { opacity: 0; transition: opacity var(--duration-base) var(--ease-out-soft); }

  .aufmass__chips { list-style: none; margin: 0; padding: 0; }
  .aufmass__chips li {
    position: absolute;
    left: var(--x);
    top: var(--y);
    transform: translate3d(0, -50%, 0);
    margin: 0;
  }

  .chip {
    display: inline-flex;
    align-items: center;
    gap: 0.4em;
    height: 2.3em;
    padding: 0 0.9em 0 0.7em;
    border-radius: 999px;
    font-size: clamp(0.62rem, 1.08cqw, 0.82rem);
    font-weight: var(--weight-bold);
    white-space: nowrap;
    text-decoration: none;
    box-shadow: 0 6px 16px -8px rgb(28 30 33 / 0.5);
    transition: transform var(--duration-fast) var(--ease-out-soft), box-shadow var(--duration-fast) var(--ease-out-soft);
  }
  .chip :global(.icon) { width: 1.25em; height: 1.25em; }
  .chip:hover { transform: translate3d(0, -2px, 0); box-shadow: 0 10px 20px -8px rgb(28 30 33 / 0.55); }
  .chip--reinigung { background: #fff; color: var(--color-petrol); border: 1px solid var(--color-border); }
  .chip--handwerk { background: var(--color-petrol); color: var(--color-primary-on-dark); border: 1px solid var(--color-primary); }
  .chip--hausmeister { background: var(--color-primary); color: var(--color-primary-contrast); border: 1px solid var(--color-primary); }

  /* Zone leuchtet auf, wenn der zugehoerige Chip Fokus oder Hover hat */
  .aufmass:has([data-zone="z-winter"]:is(:hover, :focus-visible)) #z-winter,
  .aufmass:has([data-zone="z-terrasse"]:is(:hover, :focus-visible)) #z-terrasse,
  .aufmass:has([data-zone="z-garten"]:is(:hover, :focus-visible)) #z-garten,
  .aufmass:has([data-zone="z-weg"]:is(:hover, :focus-visible)) #z-weg,
  .aufmass:has([data-zone="z-wohnen"]:is(:hover, :focus-visible)) #z-wohnen,
  .aufmass:has([data-zone="z-boden"]:is(:hover, :focus-visible)) #z-boden,
  .aufmass:has([data-zone="z-kueche"]:is(:hover, :focus-visible)) #z-kueche,
  .aufmass:has([data-zone="z-schlafen"]:is(:hover, :focus-visible)) #z-schlafen,
  .aufmass:has([data-zone="z-abstell"]:is(:hover, :focus-visible)) #z-abstell { opacity: 0.22; }

  @media (max-width: 860px) {
    .aufmass { display: none; }
  }
</style>
