---
/**
 * ReviewsStatic – Google-Rezensionen als horizontale Karten-Leiste.
 *
 * Kein Drittanbieter-Script, kein iframe, null Kilobyte Fremdcode, kein
 * Consent-Thema. Ersetzt Widgets wie BewertungsFlow oder Trustindex, die ihre
 * Inhalte erst NACH Consent nachladen: Google sieht die Rezensionen dann nie,
 * und wer das Banner ablehnt, sieht eine leere Sektion.
 *
 * VERWENDUNG
 *   examples/ReviewsStatic.astro + examples/GoogleG.astro → src/components/
 *   Daten in site.ts unter `bewertungen` pflegen:
 *     { schnitt, anzahl, liste: [{ name, zeit, text, sterne }] }
 *   Beste Position: frueh, direkt nach der Vertrauensleiste.
 *
 * AUFBAU DER KARTE (von oben nach unten):
 *   Sterne + Google-G  →  Zitat  →  Trennlinie  →  Avatar, Name, Zeitraum
 * Die Quellenangabe steht damit unten als Signatur statt oben als Etikett,
 * und das bunte G oben rechts macht auf den ersten Blick klar, dass es echte
 * Google-Bewertungen sind und keine selbst getippten Referenzen. Genau dieses
 * Echtheitszeichen ist der Grund, warum solche Leisten funktionieren.
 *
 * WARUM SLIDER, NICHT RASTER
 *   Zehn Rezensionen als Raster kosten ueber 1.000 Pixel Hoehe, als Leiste
 *   eine Kartenhoehe. Bewusst KEIN automatisches Laufband: laufenden Text
 *   kann man nicht lesen. Stattdessen Scroll-Snap – wischen auf dem Handy,
 *   Pfeile oder Tastatur am Rechner.
 *
 * DETAILS, DIE MAN SONST ZWEIMAL LERNT
 *   - Systemscrollbalken ausblenden: sonst sieht die Leiste aus wie ein
 *     versehentlich ueberlaufender Container, nicht wie ein Element.
 *   - Pfeile NEBEN die Karten, nicht darauf – ueber einem Zitat verdecken
 *     sie immer Text.
 *   - Der Zurueck-Knopf traegt `disabled` schon im Markup, sonst blitzt er
 *     beim Laden kurz aktiv auf.
 *   - `margin-top: auto` auf dem Kartenfuss: alle Karten schliessen buendig
 *     ab, egal wie lang das Zitat ist.
 *   - Zeilenbegrenzung auf dem Zitat, sonst ist eine lange Rezension dreimal
 *     so hoch wie eine kurze.
 *   - Avatar-Initialen, KEINE Gesichtsfotos. Fremde Gesichter neben einer
 *     Bewertungsangabe sind nach Anhang zu § 3 Abs. 3 UWG Nr. 23b angreifbar.
 *
 * RECHT: nur echte, woertliche Rezensionen. Keine Durchschnittsnote ohne
 * belegbare Anzahl. Mustertexte duerfen nie live gehen.
 */
import { bewertungen, site } from '../data/site';
import GoogleG from './GoogleG.astro';

interface Props {
  /** Wie viele Rezensionen in die Leiste. */
  limit?: number;
}
const { limit = 10 } = Astro.props;

const items = bewertungen.liste.slice(0, limit);

/* Auf Orange steht Anthrazit: Weiss darauf erreicht nur 2,2:1. */
const fills = [
  { bg: 'var(--color-petrol)', fg: '#fff' },
  { bg: 'var(--color-primary)', fg: 'var(--color-primary-contrast)' },
  { bg: 'var(--color-petrol-dark)', fg: '#fff' },
];

const profilUrl = `https://www.google.com/maps/place/?q=place_id:${site.google.placeId}`;
const note = bewertungen.schnitt.toLocaleString('de-DE', { minimumFractionDigits: 1 });
---

<div class="reviews-wrap" data-reviews>
  {/* Kopfzeile: Quelle links, Steuerung rechts. Die Pfeile liegen bewusst
      NEBEN den Karten und nicht darauf – ueber einem Zitat verdecken sie
      immer Text. */}
  <div class="reviews-kopf">
    <p class="reviews-quelle">
      <GoogleG size={20} />
      <span>Google Bewertungen</span>
      <span class="reviews-quelle__sterne" aria-hidden="true">
        {
          Array.from({ length: 5 }).map(() => (
            <svg viewBox="0 0 20 20" width="15" height="15">
              <path
                d="M10 1.6l2.5 5.2 5.7.7-4.2 3.9 1.1 5.6L10 14.2 4.9 17l1.1-5.6L1.8 7.5l5.7-.7z"
                fill="currentColor"
              />
            </svg>
          ))
        }
      </span>
      <span class="reviews-quelle__note">{note} aus {bewertungen.anzahl}</span>
    </p>

    <div class="reviews-steuerung">
      {/* `disabled` steht schon im Markup: die Leiste startet ganz links.
          Wuerde erst das Skript den Zustand setzen, blitzte der Knopf auf. */}
      <button type="button" class="reviews-pfeil" data-zurueck disabled aria-label="Vorherige Bewertungen">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <path d="M15 5l-7 7 7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
      <button type="button" class="reviews-pfeil" data-vor aria-label="Weitere Bewertungen">
        <svg viewBox="0 0 24 24" width="19" height="19" aria-hidden="true">
          <path d="M9 5l7 7-7 7" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
      </button>
    </div>
  </div>

  <div class="reviews" role="region" aria-label="Kundenbewertungen" tabindex="0">
    <ul class="reviews__spur">
      {
        items.map((item, i) => (
          <li class="reviews__karte">
            <div class="reviews__oben">
              <span class="reviews__sterne" role="img" aria-label={`${item.sterne} von 5 Sternen`}>
                {Array.from({ length: item.sterne }).map(() => (
                  <svg viewBox="0 0 20 20" width="16" height="16" aria-hidden="true">
                    <path
                      d="M10 1.6l2.5 5.2 5.7.7-4.2 3.9 1.1 5.6L10 14.2 4.9 17l1.1-5.6L1.8 7.5l5.7-.7z"
                      fill="currentColor"
                    />
                  </svg>
                ))}
              </span>
              <GoogleG size={18} class="reviews__g" />
            </div>

            <blockquote class="reviews__text">{item.text}</blockquote>

            <footer class="reviews__fuss">
              <span
                class="reviews__avatar"
                aria-hidden="true"
                style={`background:${fills[i % fills.length].bg};color:${fills[i % fills.length].fg}`}
              >
                {item.name.charAt(0)}
              </span>
              <span class="reviews__wer">
                <span class="reviews__name">{item.name}</span>
                <span class="reviews__zeit">{item.zeit}</span>
              </span>
            </footer>
          </li>
        ))
      }

      {/* Abschlusskarte: der Weg zu den uebrigen Bewertungen liegt dort, wo
          der Leser ohnehin ankommt. Ein Link unter der Sektion entfaellt. */}
      <li class="reviews__karte reviews__karte--mehr">
        <a class="reviews__alle" href={profilUrl} target="_blank" rel="noopener">
          <GoogleG size={30} />
          <span class="reviews__note">{note}</span>
          <span class="reviews__sterne reviews__sterne--hell" aria-hidden="true">
            {
              Array.from({ length: 5 }).map(() => (
                <svg viewBox="0 0 20 20" width="17" height="17">
                  <path
                    d="M10 1.6l2.5 5.2 5.7.7-4.2 3.9 1.1 5.6L10 14.2 4.9 17l1.1-5.6L1.8 7.5l5.7-.7z"
                    fill="currentColor"
                  />
                </svg>
              ))
            }
          </span>
          <span class="reviews__anzahl">aus {bewertungen.anzahl} Bewertungen</span>
          <span class="reviews__cta">
            Alle auf Google lesen
            <svg viewBox="0 0 24 24" width="16" height="16" aria-hidden="true">
              <path d="M5 12h14M13 6l6 6-6 6" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </span>
        </a>
      </li>
    </ul>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-reviews]').forEach((wrap) => {
    const spur = wrap.querySelector<HTMLElement>('.reviews');
    const zurueck = wrap.querySelector<HTMLButtonElement>('[data-zurueck]');
    const vor = wrap.querySelector<HTMLButtonElement>('[data-vor]');
    if (!spur || !zurueck || !vor) return;

    wrap.classList.add('hat-steuerung');

    /** Eine Karte plus Abstand – die Leiste springt um genau ein Element. */
    const schritt = () => {
      const karte = spur.querySelector<HTMLElement>('.reviews__karte');
      const liste = spur.querySelector<HTMLElement>('.reviews__spur');
      if (!karte || !liste) return spur.clientWidth;
      return karte.offsetWidth + (parseFloat(getComputedStyle(liste).columnGap) || 16);
    };

    const stand = () => {
      // 2 px Toleranz: Browser runden die Scrollposition unterschiedlich.
      const maximum = spur.scrollWidth - spur.clientWidth;
      zurueck.disabled = spur.scrollLeft <= 2;
      vor.disabled = spur.scrollLeft >= maximum - 2;
    };

    zurueck.addEventListener('click', () => spur.scrollBy({ left: -schritt(), behavior: 'smooth' }));
    vor.addEventListener('click', () => spur.scrollBy({ left: schritt(), behavior: 'smooth' }));
    spur.addEventListener('scroll', stand, { passive: true });
    addEventListener('resize', stand);
    stand();
  });
</script>

<style>
  /* --- Kopfzeile --- */
  .reviews-kopf {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    margin-bottom: var(--space-6);
  }

  .reviews-quelle {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-weight: var(--weight-semibold);
    color: var(--color-petrol);
  }
  .reviews-quelle__sterne { display: inline-flex; gap: 2px; color: var(--color-primary); }
  .reviews-quelle__sterne svg { display: block; }
  .reviews-quelle__note {
    font-weight: var(--weight-normal);
    color: var(--color-text-muted);
    font-size: var(--size-small);
    font-variant-numeric: tabular-nums;
  }

  /* Ohne JavaScript keine toten Knoepfe stehen lassen. */
  .reviews-steuerung { display: none; gap: var(--space-2); }
  .hat-steuerung .reviews-steuerung { display: flex; }

  .reviews-pfeil {
    display: grid;
    place-items: center;
    width: 2.5rem;
    height: 2.5rem;
    border: 1px solid var(--color-border);
    border-radius: 999px;
    background: var(--color-bg);
    color: var(--color-petrol);
    cursor: pointer;
    transition:
      background 160ms ease-out,
      border-color 160ms ease-out,
      opacity 160ms ease-out;
  }
  .reviews-pfeil:hover:not(:disabled) {
    background: var(--color-petrol);
    border-color: var(--color-petrol);
    color: #fff;
  }
  .reviews-pfeil:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 2px; }
  .reviews-pfeil:disabled { opacity: 0.35; cursor: default; }

  /* --- Leiste --- */
  .reviews {
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    padding-block: var(--space-1) var(--space-2);
    /* Balken ausblenden: ein Systembalken laesst die Leiste wie einen
       versehentlich ueberlaufenden Container aussehen statt wie ein Element. */
    scrollbar-width: none;
    -ms-overflow-style: none;
  }
  .reviews::-webkit-scrollbar { display: none; }
  .reviews:focus-visible { outline: 3px solid var(--color-primary); outline-offset: 4px; }

  .reviews__spur {
    display: flex;
    gap: var(--space-4);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .reviews__spur > li { margin: 0; }

  .reviews__karte {
    flex: none;
    width: min(19.5rem, 80vw);
    scroll-snap-align: start;
    display: flex;
    flex-direction: column;
    background: var(--color-bg);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: var(--space-6);
  }

  .reviews__oben {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-bottom: var(--space-4);
  }
  .reviews__sterne { display: inline-flex; gap: 2px; color: var(--color-primary); }
  .reviews__sterne svg { display: block; }
  .reviews__g { flex: none; }

  .reviews__text {
    margin: 0;
    color: var(--color-text);
    font-size: 0.9375rem;
    line-height: 1.65;
    /* Sehr lange Rezensionen waeren sonst dreimal so hoch wie kurze. Der
       vollstaendige Text steht ohnehin auf Google. */
    display: -webkit-box;
    -webkit-line-clamp: 7;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .reviews__fuss {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    /* Drueckt die Signatur nach unten: alle Karten schliessen buendig ab,
       egal wie lang das Zitat ist. */
    margin-top: auto;
    padding-top: var(--space-5, 1.25rem);
    border-top: 1px solid var(--color-border);
  }
  .reviews__avatar {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 2.375rem;
    height: 2.375rem;
    border-radius: 999px;
    font-weight: var(--weight-bold);
    font-size: 0.9375rem;
  }
  .reviews__wer { display: flex; flex-direction: column; min-width: 0; }
  .reviews__name {
    font-weight: var(--weight-semibold);
    color: var(--color-petrol);
    line-height: 1.3;
  }
  .reviews__zeit { font-size: var(--size-small); color: var(--color-text-muted); line-height: 1.3; }

  /* --- Abschlusskarte --- */
  .reviews__karte--mehr { padding: 0; border-color: transparent; background: var(--color-petrol); }
  .reviews__alle {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: center;
    gap: var(--space-2);
    height: 100%;
    padding: var(--space-6);
    text-decoration: none;
    color: #fff;
  }
  .reviews__note {
    font-family: var(--font-heading);
    font-weight: var(--weight-bold);
    font-size: 2.5rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .reviews__sterne--hell { color: var(--color-primary-on-dark); }
  .reviews__anzahl { font-size: var(--size-small); color: #c7ccd1; }
  .reviews__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    margin-top: var(--space-3);
    font-weight: var(--weight-semibold);
    color: var(--color-primary-on-dark);
  }
  .reviews__alle:hover .reviews__cta { text-decoration: underline; text-underline-offset: 3px; }
</style>
