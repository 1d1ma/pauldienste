---
/**
 * WhatsAppBubble – schwebende Chat-Blase unten rechts, mit dezentem Puls.
 *
 * Bewusst nur ein wa.me-Link: kein Drittanbieter-Script, kein iframe,
 * kein Consent-Thema, 0 KB JavaScript. Der Puls läuft ausschließlich über
 * transform/opacity auf einem ::before-Ring und respektiert
 * prefers-reduced-motion.
 *
 * VERWENDUNG (in Base.astro vor </body>):
 *   <WhatsAppBubble number={site.whatsapp}
 *     message="Guten Tag, ich möchte gern einen Termin anfragen." />
 *   number im Internationalformat ohne "+" und Leerzeichen ("4956112345").
 *   Ohne number wird nichts gerendert – so bleibt der Baustein optional.
 */
interface Props {
  number?: string;
  message?: string;
  ariaLabel?: string;
}
const {
  number,
  message = 'Guten Tag, ich habe eine Frage.',
  ariaLabel = 'Per WhatsApp schreiben',
} = Astro.props;

const href = number ? `https://wa.me/${number}?text=${encodeURIComponent(message)}` : null;
---

{
  href && (
    <a class="wa-bubble" href={href} target="_blank" rel="noopener" aria-label={ariaLabel}>
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true" fill="currentColor">
        <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.297-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 0 1 2.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 0 0-3.48-8.413Z" />
      </svg>
    </a>
  )
}

<style>
  .wa-bubble {
    position: fixed;
    right: clamp(1rem, 3vw, 1.75rem);
    bottom: clamp(1rem, 3vw, 1.75rem);
    z-index: 60;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 999px;
    background: #25d366; /* offizielles WhatsApp-Grün, bewusst außerhalb der Palette */
    color: #fff;
    box-shadow: var(--shadow);
    transition: transform var(--duration-fast) var(--ease-out-soft);
  }
  .wa-bubble:hover {
    transform: translate3d(0, -2px, 0) scale(1.04);
    color: #fff;
  }
  .wa-bubble:focus-visible {
    outline: 2px solid var(--color-primary);
    outline-offset: 3px;
  }

  /* Pulsierender Ring – nur transform/opacity, läuft auf dem Compositor */
  .wa-bubble::before {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    background: #25d366;
    z-index: -1;
  }
  @media (prefers-reduced-motion: no-preference) {
    .wa-bubble::before {
      /* Einzel-Properties: var() in der Kurzschreibweise ueberlebt die
         Minifizierung nicht zuverlaessig. */
      animation-name: wa-pulse;
      animation-duration: 2.4s;
      animation-timing-function: var(--ease-out-soft);
      animation-iteration-count: infinite;
    }
  }
  @keyframes wa-pulse {
    0% { transform: scale(1); opacity: 0.55; }
    70%, 100% { transform: scale(1.55); opacity: 0; }
  }

  @media print {
    .wa-bubble { display: none; }
  }
</style>
